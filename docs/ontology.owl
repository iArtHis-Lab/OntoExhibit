        <owl:inverseOf rdf:resource="https://w3id.org/OntoExhibit#isDeveloperOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Computational_Development"/>
        <rdfs:range rdf:resource="https://w3id.org/OntoExhibit#Developer"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/OntoExhibit#hasDigitalAnalogous -->


    <owl:ObjectProperty rdf:about="https://w3id.org/OntoExhibit#hasDigitalAnalogous">
        <owl:inverseOf rdf:resource="https://w3id.org/OntoExhibit#isDigitalAnalogousOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Material_Object"/>
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Physical_Site"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/OntoExhibit#Propositional_Object"/>
        <rdfs:comment xml:lang="en">The &quot;hasDigitalAnalogous&quot; property represents a relationship between an entity and its exact digital reproduction. This property is used to link entities to their precise digital counterparts, which maintain all attributes and characteristics of the original. Examples of such digital analogues include a PDF version of a book, a digital twin of a building or city, or an exact 3D reconstruction of a physical object. The &quot;hasDigitalAnalogous&quot; property emphasizes the fidelity and accuracy of the digital reproduction in relation to the original entity, ensuring that the digital version tends to serve as an exact representation.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/OntoExhibit#hasDigitalPlaceForActivity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/OntoExhibit#hasDigitalPlaceForActivity">
        <owl:inverseOf rdf:resource="https://w3id.org/OntoExhibit#isDigitalPlaceForActivityOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Activity_Place"/>
        <rdfs:range rdf:resource="https://w3id.org/OntoExhibit#Digital_Place"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/OntoExhibit#hasDigitalSite -->


    <owl:ObjectProperty rdf:about="https://w3id.org/OntoExhibit#hasDigitalSite">
        <owl:inverseOf rdf:resource="https://w3id.org/OntoExhibit#isDigitalSiteOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Planned_Activity"/>
        <rdfs:range rdf:resource="https://w3id.org/OntoExhibit#Digital_Site"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/OntoExhibit#hasDigitalVersion -->


    <owl:ObjectProperty rdf:about="https://w3id.org/OntoExhibit#hasDigitalVersion">
        <owl:inverseOf rdf:resource="https://w3id.org/OntoExhibit#isDigitalVersionOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Material_Object"/>
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Physical_Site"/>
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Planned_Activity"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/OntoExhibit#Propositional_Object"/>
        <rdfs:comment xml:lang="en">The &quot;hasDigitalVersion&quot; property represents a relationship between an entity and its digital counterpart, where the digital version is not merely a reproduction but a variation or interpretation of the original entity. This digital version may incorporate additional elements, contextual adjustments, or creative reinterpretations that distinguish it from a straightforward digital copy. The property emphasizes the transformative nature of the digital version, which can offer new perspectives, enhanced features, or alternative forms of engagement with the original entity. The relationship between an entity and its exact digital counterpart is defined as “hasDigitalAnalogous,” while the relationship between an activity and its mere recording is defined as “hasDigitalRecording.”</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/OntoExhibit#hasDispositif -->


    <owl:ObjectProperty rdf:about="https://w3id.org/OntoExhibit#hasDispositif">
        <owl:inverseOf rdf:resource="https://w3id.org/OntoExhibit#isDispositifOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
