    <!-- https://w3id.org/OntoExhibit#hasExhibitor -->


    <owl:ObjectProperty rdf:about="https://w3id.org/OntoExhibit#hasExhibitor">
        <owl:inverseOf rdf:resource="https://w3id.org/OntoExhibit#isExhibitorIn"/>
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Exhibitionary_Event"/>
        <rdfs:range rdf:resource="https://w3id.org/OntoExhibit#Exhibitor"/>
        <rdfs:comment xml:lang="en">This property identifies the agents (such as institutions, gallerists, collectors, etc.) that participate in an exhibition with their works. This property links an exhibition or event to the exhibitors who contribute by providing or showcasing their collections, acknowledging their role in the exhibition. For instance: Galería Alfredo Viñas isExhibitorIn Arco 2020 (art fair).</rdfs:comment>
    </owl:ObjectProperty>
    


