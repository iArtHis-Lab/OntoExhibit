    </owl:ObjectProperty>
    


    <!-- https://w3id.org/OntoExhibit#hasExhibitingActant -->


    <owl:ObjectProperty rdf:about="https://w3id.org/OntoExhibit#hasExhibitingActant">
        <owl:inverseOf rdf:resource="https://w3id.org/OntoExhibit#isExhibitingActantIn"/>
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Exhibitionary_Event"/>
        <rdfs:range rdf:resource="https://w3id.org/OntoExhibit#Actant"/>
        <rdfs:comment xml:lang="en">The &quot;hasExhibitingActant&quot; property identifies the creative agents who participate in an exhibition by showcasing their works. This property links an exhibition or event to the agents (individuals or groups) responsible for exhibiting their creations, thereby acknowledging their role in the presentation of the artworks. For instance: Picasso is ExhibitingActantIn the exhibition “Picasso, 1906. The great transformation.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/OntoExhibit#hasExhibition -->


    <owl:ObjectProperty rdf:about="https://w3id.org/OntoExhibit#hasExhibition">
