    <owl:ObjectProperty rdf:about="https://w3id.org/OntoExhibit#hasCuration">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/OntoExhibit#hasConception"/>
        <owl:inverseOf rdf:resource="https://w3id.org/OntoExhibit#isCurationOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Curatorial_Work"/>
        <rdfs:range rdf:resource="https://w3id.org/OntoExhibit#Curation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/OntoExhibit#hasCurator -->


    <owl:ObjectProperty rdf:about="https://w3id.org/OntoExhibit#hasCurator">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/OntoExhibit#hasConceptionAuthor"/>
        <owl:inverseOf rdf:resource="https://w3id.org/OntoExhibit#isCuratorOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
