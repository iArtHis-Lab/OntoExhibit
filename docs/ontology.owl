                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Work_Manifestation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/OntoExhibit#Dispositif"/>
    </owl:ObjectProperty>
    


