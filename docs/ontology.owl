    <!-- https://w3id.org/OntoExhibit#conveys -->


    <owl:ObjectProperty rdf:about="https://w3id.org/OntoExhibit#conveys">
        <owl:inverseOf rdf:resource="https://w3id.org/OntoExhibit#isConveyedBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Propositional_Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/OntoExhibit#Proposition"/>
        <rdfs:comment xml:lang="en">Conveys relates a propositional entity to one or more propositions that it bears as propositional content.</rdfs:comment>
        <rdfs:label xml:lang="en">conveys</rdfs:label>
