    <!-- https://w3id.org/OntoExhibit#represents -->


    <owl:ObjectProperty rdf:about="https://w3id.org/OntoExhibit#represents">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Art_Dealer"/>
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Gallery"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/OntoExhibit#Representation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/OntoExhibit#serveAsCelebrationOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/OntoExhibit#serveAsCelebrationOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Planned_Activity"/>
        <rdfs:range rdf:resource="https://w3id.org/OntoExhibit#Conmemorative_Event"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/OntoExhibit#servesAsCommunicationResourceOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/OntoExhibit#servesAsCommunicationResourceOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/OntoExhibit#servesAsDispositifResourceOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Planned_Activity"/>
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Propositional_Object"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/OntoExhibit#Communication_Dispositif"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/OntoExhibit#servesAsDispositifResourceOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/OntoExhibit#servesAsDispositifResourceOf">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Planned_Activity"/>
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Propositional_Object"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/OntoExhibit#Dispositif"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/OntoExhibit#servesAsDocumentationResourceOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/OntoExhibit#servesAsDocumentationResourceOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/OntoExhibit#servesAsDispositifResourceOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Propositional_Object"/>
        <rdfs:range rdf:resource="https://w3id.org/OntoExhibit#Documentation_Dispositif"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/OntoExhibit#servesAsExpansionResourceOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/OntoExhibit#servesAsExpansionResourceOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/OntoExhibit#servesAsDispositifResourceOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Planned_Activity"/>
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Propositional_Object"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/OntoExhibit#Expansion_Dispositif"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/OntoExhibit#servesAsMediationResourceOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/OntoExhibit#servesAsMediationResourceOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/OntoExhibit#servesAsDispositifResourceOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Planned_Activity"/>
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Propositional_Object"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/OntoExhibit#Mediation_Dispositif"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/OntoExhibit#takesPlaceAt -->


    <owl:ObjectProperty rdf:about="https://w3id.org/OntoExhibit#takesPlaceAt">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/OntoExhibit#hasSpatialLocus"/>
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Activity"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Techno-Place"/>
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Territorial_Entity"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">This property relates an Activity (including both Process and Planned_Activity) to its broader place of occurrence—the territorial or techno-spatial context in which the activity unfolds. It is used to record the general geographic or infrastructural setting of an activity (e.g., a city, region, country, or a digital/technical environment), independently of the specific host site. In this model, takesPlaceAt complements hasVenue: while hasVenue points to the concrete hosting site (e.g., a museum building, gallery, institutional facility, or platform-as-site), takesPlaceAt captures the wider territorial or techno-place context that situates that venue and the activity within a larger spatial frame.

Typical use:

Exhibition hasVenue Villanueva building (Museo del Prado) (site)

Exhibition takesPlaceAt Madrid (territorial entity)

Online activities may use takesPlaceAt to indicate the relevant techno-place (e.g., a platform/ecosystem) when the broader infrastructural context matters.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/OntoExhibit#wasProducedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/OntoExhibit#wasProducedBy">
        <owl:inverseOf rdf:resource="https://w3id.org/OntoExhibit#wasTheProducerOf"/>
        <rdfs:domain rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E12_Production"/>
        <rdfs:range rdf:resource="https://w3id.org/OntoExhibit#Producer"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/OntoExhibit#wasTheProducerOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/OntoExhibit#wasTheProducerOf">
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Producer"/>
        <rdfs:range rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E12_Production"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/OntoExhibit#hasNarrative/ThematicUnit -->


    <owl:ObjectProperty rdf:about="https://w3id.org/OntoExhibit#hasNarrative/ThematicUnit">
        <owl:inverseOf rdf:resource="https://w3id.org/OntoExhibit#isNarrative/ThematicUnitOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Conceptual_Work"/>
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Preliminary_Ideas"/>
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Proposition"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/OntoExhibit#Narrative_Thematic_Unit"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/OntoExhibit#isNarrative/ThematicUnitOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/OntoExhibit#isNarrative/ThematicUnitOf">
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Narrative_Thematic_Unit"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Conceptual_Work"/>
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Preliminary_Ideas"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#lat -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#lat">
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Physical_Site"/>
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Territorial_Entity"/>
        <rdfs:label xml:lang="en">geo:lat</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#long -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#long">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Physical_Site"/>
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Territorial_Entity"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:label xml:lang="en">geo:long</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#ISIC4Category -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#ISIC4Category">
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Company"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">ISIC4 category</rdfs:label>
        <rdfs:label xml:lang="es">categoría ISIC4</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#access -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#access">
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Planned_Activity"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>free</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>paid</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label xml:lang="en">access type</rdfs:label>
        <rdfs:label xml:lang="es">tipo de acceso</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#activity_status -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#activity_status">
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Activity"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>canceled</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>completed</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>ongoing</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>scheduled</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label xml:lang="en">activity status</rdfs:label>
        <rdfs:label xml:lang="es">estado de actividad</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#activity_type -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#activity_type">
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Collective_Human_Actant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">activity type</rdfs:label>
        <rdfs:label xml:lang="es">tipo de actividad</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#address -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#address">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Physical_Site"/>
        <rdfs:label xml:lang="en">address</rdfs:label>
        <rdfs:label xml:lang="es">dirección postal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#apelation -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#apelation">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The &quot;appellation&quot; data property represents alternative names, titles, or designations assigned to an entity, other than the official name. This property is used to specify commonly recognized names, nicknames, colloquial titles, or other forms of identification that serve to distinguish and identify the entity beyond its official designation. Instances are El Greco, Museo Reina Sofía (being the official name: Museo Nacional Centro de Arte Reina Sofía), Big Apple (New York), El Quijote, etc.</rdfs:comment>
        <rdfs:label xml:lang="es">apelativo</rdfs:label>
        <rdfs:label xml:lang="en">appellation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#awards -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#awards">
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Art_Competition"/>
        <rdfs:comment xml:lang="en">Describes the prizes or recognitions that will be awarded to the winners.</rdfs:comment>
        <rdfs:label xml:lang="en">awards</rdfs:label>
        <rdfs:label xml:lang="es">premio</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#budget -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#budget">
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Planned_Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">budget</rdfs:label>
        <rdfs:label xml:lang="es">presupuesto</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#content -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#content">
        <rdfs:domain rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E28_Conceptual_Object"/>
        <rdfs:label xml:lang="en">contenido</rdfs:label>
        <rdfs:label xml:lang="es">contenido</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#degree -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#degree">
        <rdfs:domain rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E21_Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">degree</rdfs:label>
        <rdfs:label xml:lang="es">titulación</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#description -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#description">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">A detailed textual description of the entity, including its purpose, functionalities, and key features.</rdfs:comment>
        <rdfs:label xml:lang="es">descripción</rdfs:label>
        <rdfs:label xml:lang="en">description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#executive_position_type -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#executive_position_type">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Executive_Position"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>CEO</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>director</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>president</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label xml:lang="en">executive position type</rdfs:label>
        <rdfs:label xml:lang="es">tipo de puesto ejecutivo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#gender -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#gender">
        <rdfs:domain rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E21_Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">gender</rdfs:label>
        <rdfs:label xml:lang="es">género</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#identifier -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#identifier">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">The &quot;identifier&quot; data property represents a unique code, number, or string assigned to an entity within various authority vocabularies. This property is used to specify the authoritative identifier that distinguishes an entity in controlled vocabularies, databases, or registries maintained by recognized institutions or organizations. Identifiers ensure consistent and unambiguous reference to entities across different systems and contexts.</rdfs:comment>
        <rdfs:label xml:lang="es">identificador</rdfs:label>
        <rdfs:label xml:lang="en">identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#name -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#name">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The official name or designation of an entity.</rdfs:comment>
        <rdfs:label xml:lang="es">denominación</rdfs:label>
        <rdfs:label xml:lang="en">name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#numberOfAttendants -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#numberOfAttendants">
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Planned_Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">number of attendants</rdfs:label>
        <rdfs:label xml:lang="es">número de asistentes</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#number_of_visitors -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#number_of_visitors">
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Techno-Place"/>
        <rdfs:label xml:lang="en">number of visitors</rdfs:label>
        <rdfs:label xml:lang="es">número de visitantes</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#ownershipType -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#ownershipType">
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Institution"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>mixed</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>private</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>public</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label xml:lang="en">ownership type</rdfs:label>
        <rdfs:label xml:lang="es">titularidad</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#person_name -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#person_name">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/OntoExhibit#name"/>
        <rdfs:domain rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E21_Person"/>
        <rdfs:label xml:lang="es">nombre</rdfs:label>
        <rdfs:label xml:lang="en">person name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#population -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#population">
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Territorial_Entity"/>
        <rdfs:comment xml:lang="en">Number of inhabitants.</rdfs:comment>
        <rdfs:label xml:lang="es">población</rdfs:label>
        <rdfs:label xml:lang="en">population</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#professional_activity -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#professional_activity">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E21_Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="es">actividad profesional</rdfs:label>
        <rdfs:label xml:lang="en">professional activity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#program -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#program">
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Planned_Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">program</rdfs:label>
        <rdfs:label xml:lang="es">programa</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#socialNetworkProfile -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#socialNetworkProfile">
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Human_Actant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label xml:lang="es">perfil en red social</rdfs:label>
        <rdfs:label xml:lang="en">social network profile</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#software_version -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#software_version">
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Techno-Actant"/>
        <rdfs:comment xml:lang="en">A detailed list of the technical specifications and requirements of the techno-actant.</rdfs:comment>
        <rdfs:label xml:lang="en">software version</rdfs:label>
        <rdfs:label xml:lang="es">versión de software</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#status -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#status">
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Techno-Actant"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>active</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>innctive</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>under maintenance</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">A detailed list of the technical specifications and requirements of the techno-actant.</rdfs:comment>
        <rdfs:label xml:lang="es">estado</rdfs:label>
        <rdfs:label xml:lang="en">status</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#sustrate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#sustrate">
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Material_Object"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>digital</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>physical</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label xml:lang="en">sustrate</rdfs:label>
        <rdfs:label xml:lang="es">sustrato</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#technical_specifications -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#technical_specifications">
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Techno-Actant"/>
        <rdfs:comment xml:lang="en">A detailed list of the technical specifications and requirements of the techno-actant.</rdfs:comment>
        <rdfs:label xml:lang="es">especificaciones técnicas</rdfs:label>
        <rdfs:label xml:lang="en">technical specifications</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#techno-placeType -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#techno-placeType">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Techno-Place"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>infrastructure</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>metaverse</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>museum platform</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>social network</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label xml:lang="en">techno-place type</rdfs:label>
        <rdfs:label xml:lang="es">tipo de tecnolugar</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#ticket_price -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#ticket_price">
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Planned_Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="es">tarifa</rdfs:label>
        <rdfs:label xml:lang="en">ticket price</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#url -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#url">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/OntoExhibit#Techno-Place"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/OntoExhibit#webPage -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/OntoExhibit#webPage">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Human_Actant"/>
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Planned_Activity"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label xml:lang="es">página web</rdfs:label>
        <rdfs:label xml:lang="en">webpage</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.cidoc-crm.org/cidoc-crm/E7_Activity -->


    <owl:Class rdf:about="http://www.cidoc-crm.org/cidoc-crm/E7_Activity">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E5_Event"/>
    </owl:Class>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/E7_Activity#process -->


    <owl:Class rdf:about="http://www.cidoc-crm.org/cidoc-crm/E7_Activity#process">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Activity"/>
        <rdfs:comment xml:lang="en">Process comprises transformative activities—coherent sequences of actions or operations—carried out by one or more actants, typically exhibiting an internal structure (e.g., phases, tasks, iterations) and an appreciable duration. A process mobilizes resources, techniques, and collaborations toward an intended purpose, producing state changes and potentially generating material or conceptual outcomes.</rdfs:comment>
        <rdfs:label xml:lang="es">proceso</rdfs:label>
        <rdfs:label xml:lang="en">process</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2004/02/skos/core#Concept -->


    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept">
        <owl:equivalentClass rdf:resource="https://w3id.org/OntoExhibit#ordering_principle"/>
    </owl:Class>
    


    <!-- https://cidoc-crm.org/cidoc-crm/7.1.1/E12_Production -->


    <owl:Class rdf:about="https://cidoc-crm.org/cidoc-crm/7.1.1/E12_Production">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E65_Creation"/>
        <rdfs:comment xml:lang="en">The &quot;Production&quot; class represents the activities involved in the creation and fabrication of material objects.</rdfs:comment>
        <rdfs:label xml:lang="es">producción</rdfs:label>
        <rdfs:label xml:lang="en">production</rdfs:label>
    </owl:Class>
    


    <!-- https://cidoc-crm.org/cidoc-crm/7.1.1/E21_Person -->


    <owl:Class rdf:about="https://cidoc-crm.org/cidoc-crm/7.1.1/E21_Person">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Human_Actant"/>
        <rdfs:comment xml:lang="en">This class comprises real individual human beings who live or are assumed to have lived.</rdfs:comment>
        <rdfs:label xml:lang="en">person</rdfs:label>
        <rdfs:label xml:lang="es">persona</rdfs:label>
        <owl:equivalentClass rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://xmlns.com/foaf/spec/#term_Person</owl:equivalentClass>
    </owl:Class>
    


    <!-- https://cidoc-crm.org/cidoc-crm/7.1.1/E28_Conceptual_Object -->


    <owl:Class rdf:about="https://cidoc-crm.org/cidoc-crm/7.1.1/E28_Conceptual_Object">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Object"/>
        <rdfs:comment xml:lang="en">This class comprises purely conceptual and/or intellectual entities without concrete materialization. They constitute results derived from human intellectual and creative activity, with or without the assistance of non-human agencies.</rdfs:comment>
        <rdfs:label xml:lang="en">conceptual object</rdfs:label>
        <rdfs:label xml:lang="es">objeto conceptual</rdfs:label>
    </owl:Class>
    


    <!-- https://cidoc-crm.org/cidoc-crm/7.1.1/E5_Event -->


    <owl:Class rdf:about="https://cidoc-crm.org/cidoc-crm/7.1.1/E5_Event">
        <rdfs:comment xml:lang="en">This class comprises any occurrence or happening that involves a change or a series of change over time. It encompasses specific and goal-oriented processes, such as creative and productive activities, that result in particular conceptual or material outcomes, and broader, organized and planned endeavors, such as exhibitions or conferences.  They are characterized by their temporal and spatial dimensions.</rdfs:comment>
        <rdfs:label xml:lang="en">E5_Event</rdfs:label>
        <rdfs:label xml:lang="es">evento</rdfs:label>
        <owl:equivalentClass xml:lang="en">https://cidoc-crm.org/html/cidoc_crm_v7.1.2.html#E5</owl:equivalentClass>
        <owl:equivalentClass xml:lang="en">https://www.iflastandards.info/fr/frbr/frbroo#F8</owl:equivalentClass>
    </owl:Class>
    


    <!-- https://cidoc-crm.org/cidoc-crm/7.1.1/E63_Beginning_of_Existence -->


    <owl:Class rdf:about="https://cidoc-crm.org/cidoc-crm/7.1.1/E63_Beginning_of_Existence">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity#process"/>
        <rdfs:label xml:lang="en">beginning of existence</rdfs:label>
        <rdfs:label xml:lang="es">inicio de existencia</rdfs:label>
    </owl:Class>
    


    <!-- https://cidoc-crm.org/cidoc-crm/7.1.1/E64_End_of_Existence -->


    <owl:Class rdf:about="https://cidoc-crm.org/cidoc-crm/7.1.1/E64_End_of_Existence">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity#process"/>
        <rdfs:label xml:lang="en">end of existence</rdfs:label>
        <rdfs:label xml:lang="es">fin de existencia</rdfs:label>
    </owl:Class>
    


    <!-- https://cidoc-crm.org/cidoc-crm/7.1.1/E65_Creation -->


    <owl:Class rdf:about="https://cidoc-crm.org/cidoc-crm/7.1.1/E65_Creation">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E63_Beginning_of_Existence"/>
        <owl:disjointWith rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E6_Destruction"/>
        <rdfs:comment xml:lang="en">This class refers to the process or act of bringing an object (conceptual or material) into existence.</rdfs:comment>
        <rdfs:label xml:lang="es">creación</rdfs:label>
        <rdfs:label xml:lang="en">creation</rdfs:label>
    </owl:Class>
    


    <!-- https://cidoc-crm.org/cidoc-crm/7.1.1/E67_Birth -->


    <owl:Class rdf:about="https://cidoc-crm.org/cidoc-crm/7.1.1/E67_Birth">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Biological_Event"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasTimeSpan"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#takesPlaceAt"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Territorial_Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">birth</rdfs:label>
        <rdfs:label xml:lang="es">nacimiento</rdfs:label>
    </owl:Class>
    


    <!-- https://cidoc-crm.org/cidoc-crm/7.1.1/E68_Dissolution -->


    <owl:Class rdf:about="https://cidoc-crm.org/cidoc-crm/7.1.1/E68_Dissolution">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E64_End_of_Existence"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasTimeSpan"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/OntoExhibit#Foundation"/>
        <rdfs:comment xml:lang="en">The &quot;Dissolution&quot; class represents the process and act of formally disbanding or terminating groups, institutions, organizations, or other entities.</rdfs:comment>
        <rdfs:label xml:lang="es">disolución</rdfs:label>
        <rdfs:label xml:lang="en">dissolution</rdfs:label>
    </owl:Class>
    


    <!-- https://cidoc-crm.org/cidoc-crm/7.1.1/E69_Death -->


    <owl:Class rdf:about="https://cidoc-crm.org/cidoc-crm/7.1.1/E69_Death">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Biological_Event"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasTimeSpan"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#takesPlaceAt"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Territorial_Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">death</rdfs:label>
        <rdfs:label xml:lang="es">muerte</rdfs:label>
    </owl:Class>
    


    <!-- https://cidoc-crm.org/cidoc-crm/7.1.1/E6_Destruction -->


    <owl:Class rdf:about="https://cidoc-crm.org/cidoc-crm/7.1.1/E6_Destruction">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E64_End_of_Existence"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasTimeSpan"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The &quot;Destruction&quot; class represents the process and act of causing material objects to become damaged, dismantled, or rendered unusable. This includes any activities that lead to the degradation, disintegration, or obliteration of objects, whether intentional or accidental. The Destruction class is crucial for documenting and understanding the loss or alteration of material objects within various contexts, such as art conservation, historical documentation, and cultural heritage preservation.</rdfs:comment>
        <rdfs:label xml:lang="es">destrucción</rdfs:label>
        <rdfs:label xml:lang="en">destruction</rdfs:label>
    </owl:Class>
    


    <!-- https://cidoc-crm.org/cidoc-crm/7.1.1/E74_Group -->


    <owl:Class rdf:about="https://cidoc-crm.org/cidoc-crm/7.1.1/E74_Group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Collective_Human_Actant"/>
        <rdfs:comment xml:lang="en">This class comprises human actors organized into groups, such as artist groups, who act collectively in their roles or activities within the art exhibition domain, but does not necessarily have a legal or corporate structure. This class has a different scope from the CIDOC-CRM E74 Group class, which also includes institutions. In the context of the OntoExhibit ontology, institutions constitute a distinct class as they are recognized to have a legal personality different from that of groups, with a more complex and formal structure, and specific functions that are regulated and acknowledged by society. See the “Institution” class as a subclass of “Corporate Body”.</rdfs:comment>
        <rdfs:label xml:lang="en">group</rdfs:label>
        <rdfs:label xml:lang="es">grupo</rdfs:label>
        <owl:equivalentClass rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://xmlns.com/foaf/spec/#term_Group</owl:equivalentClass>
    </owl:Class>
    


    <!-- https://cidoc-crm.org/cidoc-crm/7.1.1/Place -->


    <owl:Class rdf:about="https://cidoc-crm.org/cidoc-crm/7.1.1/Place">
        <rdfs:comment xml:lang="en">Place represents any spatial or locative context in which events, practices, or cultural processes are situated. It covers a broad spectrum of locations, ranging from geopolitical entities (e.g., countries, regions, cities) and built environments (e.g., buildings, rooms, exhibition halls) to techno-digital environments (e.g., online platforms, virtual spaces, networked interfaces). The class is intended to support the description of the multiple spatial conditions under which art is produced, curated, mediated, displayed, and experienced. Place is broader than CIDOC CRM’s E53 Place, which is restricted to physical space. OntoExhibit maintains compatibility with CRM by allowing physical places to align with E53 where appropriate, while also accommodating techno-digital places that fall outside CRM’s strictly physical scope.</rdfs:comment>
        <rdfs:comment xml:lang="en">Within OntoExhibit, Place functions as a general umbrella category that supports more specific, role-oriented subclasses. In particular, Site captures places in their capacity as exhibition venues (i.e., where an exhibition is presented to audiences), while Process_Locus captures places in their capacity as loci of cultural processes (e.g., where conception, curation, creation, foundation, dissolution, or destruction are situated). A given place may play none, one, or multiple such roles depending on the relationships asserted in the knowledge graph; therefore, these subclasses should not be read as fixed “types of place,” but as analytically meaningful contextualizations of place within exhibition ecosystems.</rdfs:comment>
        <rdfs:label xml:lang="es">lugar</rdfs:label>
        <rdfs:label xml:lang="en">place</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Academy_Of_Fine_Arts -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Academy_Of_Fine_Arts">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Cultural_Institution"/>
        <rdfs:label xml:lang="es">academia de bellas artes</rdfs:label>
        <rdfs:label xml:lang="en">academy of fine arts</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Actant -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Actant">
        <rdfs:comment xml:lang="en">This class comprises entities that engage in a role or perform specific activities, either on their own initiative or mobilized by other entities. In the context of the OntoExhibit ontology, it refers to those entities that play an active role in the art exhibition domain. This class is broader than the CIDOC-CRM E39 Actor class, which is limited to human entities. Additionally, the decision to use the term &quot;actant&quot; over the more conventional term &quot;actor&quot; stems from the Greimasian tradition, where the condition of being an actant is determined by the specific role or function that an entity performs. In contrast, the term &quot;actor,&quot; as currently associated with the concept of actor in Bruno Latour&apos;s actor-network theory, is defined by its capacity to exert agency. Acknowledging that any entity might possess agency within a specific context or time, the class labeled as “actor” would be all-encompassing, including all classes. Conversely, designating a distinct class as &quot;actor&quot; would restrict agency value to those classes classified as subclasses of actor.</rdfs:comment>
        <rdfs:label xml:lang="en">actant</rdfs:label>
        <rdfs:label xml:lang="es">actante</rdfs:label>
        <owl:equivalentClass rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://xmlns.com/foaf/spec/#term_Agent</owl:equivalentClass>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Activity -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Activity">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity"/>
        <rdfs:comment xml:lang="en">This class comprises specific, goal-oriented actions and operations carried out by a single agent or a collective. Activities are concrete, distinguishable events situated in a spatio-temporal context, typically involving coordination, resources, and participation. They may lead to material or conceptual outcomes, and include both transformative processes (e.g., creation, production, curation) and planned or programmed activities (e.g., concerts, lectures, openings).</rdfs:comment>
        <rdfs:label xml:lang="es">actividad</rdfs:label>
        <rdfs:label xml:lang="en">activity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Activity_Place -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Activity_Place">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#professional_context"/>
        <rdfs:comment xml:lang="en">Place of Activity is an intermediary (reified) spatio-temporal context that links a human actant (or collective) to one or more places in which they carry out professional activities during a defined time range. It is intended to capture activity geographies that may be distributed across multiple locations rather than reducible to a single, fixed base. For example, an art gallery may operate through branches, fairs, collaborations, or recurring programs in several cities beyond the city where its main office is located.

In OntoExhibit, Place of Activity supports the analysis of dispersed cultural work and the spatial dynamics of professional trajectories. The set of places connected to an actant through successive or concurrent instances of Place of Activity constitutes the actant’s broader area of activity, enabling comparative study of mobility, networked operations, and the territorial and techno-digital reach of actors within exhibition ecosystems.</rdfs:comment>
        <rdfs:label xml:lang="en">activity place</rdfs:label>
        <rdfs:label xml:lang="es">lugar de actividad</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Affiche -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Affiche">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Visual_Information_Object"/>
        <rdfs:label xml:lang="en">affiche</rdfs:label>
        <rdfs:label xml:lang="es">póster</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Affiliation -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Affiliation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#professional_context"/>
        <rdfs:comment xml:lang="en">Affiliation is an intermediary (reified) spatio-temporal context that records a formal staff relationship between an individual and an organisation. It captures cases in which a person is affiliated with an institution through employment or an equivalent contractual arrangement, performing defined roles and responsibilities within the organisation during a specific time range (and, where relevant, under particular terms or statuses).

In OntoExhibit, Affiliation supports the analysis of institutional labour and professional trajectories by making staff relationships explicit, time-qualified, and queryable, without reducing them to a timeless link between a person and an organisation.</rdfs:comment>
        <rdfs:label xml:lang="en">affiliation</rdfs:label>
        <rdfs:label xml:lang="es">afiliación</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Agent_of_Destruction -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Agent_of_Destruction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#isRoleOf"/>
                <owl:allValuesFrom rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E6_Destruction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">agent of destruction</rdfs:label>
        <rdfs:label xml:lang="es">agente de destrucción</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Alma_Mater -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Alma_Mater">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#isRoleOf"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Educational_Institution"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">alma mater</rdfs:label>
        <rdfs:label xml:lang="es">alma mater</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Approximate_Date -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Approximate_Date">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Date"/>
        <rdfs:comment xml:lang="en">The &quot;Approximate Date&quot; class represents a point in time that is not defined with precise accuracy but is estimated to fall within a certain range. This includes dates that are roughly known, such as an approximate year, month, or day, and can be used when exact dates are not available or necessary. Approximate Dates are useful for historical research, planning, and scenarios where only an estimated timeframe is required.</rdfs:comment>
        <rdfs:label xml:lang="en">approximate date</rdfs:label>
        <rdfs:label xml:lang="es">fecha aproximada</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Architectural_Project -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Architectural_Project">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Conceptual_Work"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasManifestation"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Architectural_Work_Manifestation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">architectural project</rdfs:label>
        <rdfs:label xml:lang="es">proyecto arquitectónico</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Architectural_Work_Manifestation -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Architectural_Work_Manifestation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Work_Manifestation"/>
        <rdfs:comment xml:lang="en">The &quot;Architectural Work Manifestation&quot; class represents the tangible manifestation of an architectural project.</rdfs:comment>
        <rdfs:label xml:lang="en">architectural work manifestation</rdfs:label>
        <rdfs:label xml:lang="es">manifestación de obra arquitectónica</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Archive -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Archive">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Cultural_Institution"/>
        <rdfs:label xml:lang="en">archive</rdfs:label>
        <rdfs:label xml:lang="es">archivo</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Art_Center -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Art_Center">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Cultural_Institution"/>
        <rdfs:label xml:lang="en">art center</rdfs:label>
        <rdfs:label xml:lang="es">centro de arte</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Art_Competition -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Art_Competition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Exhibitionary_Event"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasTimeSpan"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Time_Range"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The &quot;Art Competition&quot; class represents an organized event where participants submit their artworks to be evaluated and judged, with the goal of winning prizes or recognition.  These events also serve to showcase artworks to the public in a competitive context.</rdfs:comment>
        <rdfs:label xml:lang="en">art competition</rdfs:label>
        <rdfs:label xml:lang="es">concurso artístico</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Art_Dealer -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Art_Dealer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="en">art dealer</rdfs:label>
        <rdfs:label xml:lang="es">marchante</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Art_Exhibition_Digital_Platform -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Art_Exhibition_Digital_Platform">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Digital_Platform"/>
        <rdfs:comment xml:lang="es">Plataforma para exposiciones</rdfs:comment>
        <rdfs:comment xml:lang="en">This class represents digital platforms specifically designed to produce, host, and present digital exhibitions. An instance of this class is the ‘New Art City’ platform.</rdfs:comment>
        <rdfs:label xml:lang="en">art exhibition digital platform</rdfs:label>
        <rdfs:label xml:lang="es">plataforma digital para exposiciones</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Art_School -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Art_School">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Educational_Institution"/>
        <rdfs:label xml:lang="en">art school</rdfs:label>
        <rdfs:label xml:lang="es">escuela de arte</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Artists_Group -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Artists_Group">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E74_Group"/>
        <rdfs:comment xml:lang="en">A group of individuals who collaborate or associate under a common name or collective identity with the purpose of creating, exploring, or exhibiting art.</rdfs:comment>
        <rdfs:label xml:lang="en">artists group</rdfs:label>
        <rdfs:label xml:lang="es">grupo de artistas</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Artwork -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Artwork">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Work_Manifestation"/>
        <rdfs:label xml:lang="en">artwork</rdfs:label>
        <rdfs:label xml:lang="es">objeto artístico</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Assement_Assignment -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Assement_Assignment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Proposition_Assignment"/>
        <rdfs:comment xml:lang="en">The &quot;Assessment Assignment&quot; class represents the act or process of evaluating, appraising, or judging the quality, value, or significance of an entity or work. Assessment Assignments can be applied to artworks, projects, performances, or any other entities that require formal evaluation.</rdfs:comment>
        <rdfs:label xml:lang="es">asignación de valoración</rdfs:label>
        <rdfs:label xml:lang="en">assessment assignment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Assessment -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Assessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Proposition"/>
        <rdfs:comment xml:lang="en">An evaluative proposition expressing a judgment (explicit or implicit) according to criteria or standards, potentially including gradations, comparisons, or attributions of quality/fitness.</rdfs:comment>
        <rdfs:label xml:lang="en">assessment</rdfs:label>
        <rdfs:label xml:lang="es">valoración</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Assignment -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Assignment">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E5_Event"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasTimeSpan"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The &quot;Assignment&quot; class represents the action of assigning attributes, propositions, statements, evaluations, critical assessment, interpretations, or similar elements to entities. This action involves linking specific descriptive, interpretative or evaluative contents to artworks, exhibitions, cultural creations and events, or any relevant subjects within the domain. The Assignment class is essential for providing additional context, meaning, or evaluation to entities, thereby enhancing understanding, interpretation, and scholarly analysis.</rdfs:comment>
        <rdfs:label xml:lang="es">asignación</rdfs:label>
        <rdfs:label xml:lang="en">assignment</rdfs:label>
        <owl:equivalentClass>https://cidoc-crm.org/html/cidoc_crm_v7.1.2.html#E13</owl:equivalentClass>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Assistant -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Assistant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="es">asistente</rdfs:label>
        <rdfs:label xml:lang="en">assistant</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Assistant_Curator -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Assistant_Curator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Assistant"/>
        <rdfs:label xml:lang="es">asistente de comisario/a</rdfs:label>
        <rdfs:label xml:lang="en">assistant curator</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Attendant -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Attendant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="es">asistente</rdfs:label>
        <rdfs:label xml:lang="en">attendant</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Auction -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Auction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Exhibitionary_Event"/>
        <rdfs:comment xml:lang="en">The &quot;Auction&quot; class represents a type of &quot;Exhibitionary Event&quot; where artworks, artifacts, or other items are presented for sale to the highest bidder. Auctions are typically organized by auction houses, galleries, or other entities, and they attract collectors, dealers, and the general public.</rdfs:comment>
        <rdfs:label xml:lang="en">auction</rdfs:label>
        <rdfs:label xml:lang="es">subasta</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Auction_House -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Auction_House">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Company"/>
        <rdfs:label xml:lang="en">auction house</rdfs:label>
        <rdfs:label xml:lang="es">casa de subastas</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Author -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Author">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Creator"/>
        <rdfs:comment xml:lang="en">The &quot;Author&quot; class represents individuals or entities responsible for the creation and conceptualization within art exhibitions. This includes not only the creators of the exhibited works, such as visual artists, sculptors, painters, photographers, and multimedia artists, but also those involved in the conceptualization of the exhibition itself, the design of the museographic elements, and other creative and productive contributions that shape the overall experience of the exhibition.</rdfs:comment>
        <rdfs:label xml:lang="en">author</rdfs:label>
        <rdfs:label xml:lang="es">autor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Beginning_Of_Activity -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Beginning_Of_Activity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Planned_Activity"/>
        <rdfs:comment xml:lang="en">The &quot;Beginning of Activity&quot; class represents the initial actions or events that mark the commencement of a larger activity or event. This includes ceremonies, inaugural speeches, opening performances, or any other activities that signify the start of an event or activity.</rdfs:comment>
        <rdfs:label xml:lang="en">beginning of activity</rdfs:label>
        <rdfs:label xml:lang="es">inicio de actividad</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Biennial -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Biennial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Exhibition"/>
        <rdfs:comment xml:lang="en">The &quot;Biennial&quot; class represents a large-scale exhibition event that occurs every two years, showcasing a curated selection of artworks, often from a diverse range of artists, disciplines, and cultural backgrounds. Biennials are significant events in the art world, designed to present cutting-edge contemporary art, foster international cultural exchange, and engage with global artistic trends. These events typically span several months and include various programs such as exhibitions, performances, panel discussions, workshops, and educational activities.</rdfs:comment>
        <rdfs:label xml:lang="es">bienal</rdfs:label>
        <rdfs:label xml:lang="en">biennial</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Biological_Event -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Biological_Event">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E5_Event"/>
        <rdfs:comment xml:lang="es">A biological event refers to any significant occurrence or process within a biological system that results in a change or development in the organism, population, or ecosystem.</rdfs:comment>
        <rdfs:label xml:lang="en">biological event</rdfs:label>
        <rdfs:label xml:lang="es">evento biológico</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Biological_Object -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Biological_Object">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Non_Produced_Material_Object"/>
        <rdfs:comment xml:lang="en">The &quot;Biological Object&quot; class represents entities derived from living organisms, including plants, animals, fungi, and microorganisms. These objects are naturally occurring and can be displayed in art exhibitions for their scientific, educational, aesthetic, or cultural significance. Biological Objects may include specimens, preserved samples, live organisms, or parts of organisms (such as leaves, bones, shells, or feathers) and can be integral components of artworks or installations, providing a unique intersection between art and nature.</rdfs:comment>
        <rdfs:label xml:lang="en">biological object</rdfs:label>
        <rdfs:label xml:lang="es">organismo biológico</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Brochure -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Brochure">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Information_Object"/>
        <rdfs:label xml:lang="en">brochure</rdfs:label>
        <rdfs:label xml:lang="es">folleto</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Building -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Building">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#physical_place"/>
        <rdfs:label xml:lang="en">building</rdfs:label>
        <rdfs:label xml:lang="es">edificio</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Caption -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Caption">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Linguistic_Information_Object"/>
        <rdfs:label xml:lang="en">caption</rdfs:label>
        <rdfs:label xml:lang="es">pie de foto</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Catalog -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Catalog">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Information_Object"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Work_Manifestation"/>
        <rdfs:label xml:lang="en">catalogue</rdfs:label>
        <rdfs:label xml:lang="es">catálogo</rdfs:label>
        <modelingNote xml:lang="en">Modeling guideline: Use Catalogue as Information_Object when it is primarily modeled as documentary support (credits, lists, descriptions, paratexts, references). Add typing as Work_Manifestation when the catalogue is modeled as a publishable/citable manifestation in its own right (edition, circulation, reception, authorship or editorial responsibility, versioning).</modelingNote>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Chapter -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Chapter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Narrative_Thematic_Unit"/>
        <rdfs:label xml:lang="es">capítulo</rdfs:label>
        <rdfs:label xml:lang="en">chapter</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Closing -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Closing">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#End_Of_Activity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasTimeSpan"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">clausura</rdfs:label>
        <rdfs:label xml:lang="en">closing</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Collaborator -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Collaborator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="es">colaborador</rdfs:label>
        <rdfs:label xml:lang="en">collaborator</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Collective_Human_Actant -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Collective_Human_Actant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Human_Actant"/>
        <rdfs:comment xml:lang="en">A group of individuals who act together as a collective entity to influence, participate in, or intervene in specific processes or situations. This collective may be formal, such as institutions or professional associations, or informal, such as social communities or an interest group.</rdfs:comment>
        <rdfs:label xml:lang="es">actante humano colectivo</rdfs:label>
        <rdfs:label xml:lang="en">collective human actant</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Collector -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Collector">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="es">coleccionista</rdfs:label>
        <rdfs:label xml:lang="en">collector</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Comment -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Comment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Proposition"/>
        <rdfs:comment xml:lang="en">A proposition formulated as a comment: a brief, situated—often reactive—statement expressing an observation, evaluation, interpretation, agreement/disagreement, or qualification regarding an entity or situation in the exhibition ecosystem. It is distinct from any specific materialization or carrier (e.g., post, note, or form entry), which is modeled elsewhere.</rdfs:comment>
        <rdfs:label xml:lang="es">comentario</rdfs:label>
        <rdfs:label xml:lang="en">comment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Commissioner -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Commissioner">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="es">comitente</rdfs:label>
        <rdfs:label xml:lang="en">commissioner</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Communication_Activity -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Communication_Activity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Planned_Activity"/>
        <rdfs:comment xml:lang="en">The &quot;Communication Activity&quot; class represents any activity aimed at conveying information, promoting events, engaging with audiences, or facilitating interaction and dialogue. This includes a wide range of activities such as public relations campaigns, social media interactions, press releases, newsletters, and other forms of communication that support the dissemination and reception of information related to art exhibitions and cultural events.</rdfs:comment>
        <rdfs:label xml:lang="es">actividad de comunicación</rdfs:label>
        <rdfs:label xml:lang="en">communication activity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Communication_Dispositif -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Communication_Dispositif">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Dispositif"/>
        <rdfs:comment xml:lang="en">The &quot;Communication Dispositif&quot; class represents materials and events used to communicate and disseminate information about cultural activities and productions. These dispositifs typically include press releases, brochures, websites, social media posts, newsletters, and other structured systems or media that convey information to the public and stakeholders. Additionally, other objects and materials can also serve this purpose. Therefore, this class links cultural activities and productions with those propositional objects and events that inform about them, regardless of their nature, genre, or typology.</rdfs:comment>
        <rdfs:label xml:lang="en">communication dispositif</rdfs:label>
        <rdfs:label xml:lang="es">dispositivo de comunicación</rdfs:label>
        <modelingNote xml:lang="en">This class is not disjoint with other dispositif types; see Dispositif modeling note.</modelingNote>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Communities -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Communities">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E74_Group"/>
        <rdfs:comment xml:lang="en">A group of individuals who interact informally moved by shared interests. In the context of the OntoExhibit ontology, this class specifically refers to communities that interact on social media platforms, such as Twitter, Facebook, Discord, etc. This class would include, for example, instances of DAOs (decentralized autonomous organizations).</rdfs:comment>
        <rdfs:label xml:lang="en">community</rdfs:label>
        <rdfs:label xml:lang="es">comunidad</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Company -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Company">
        <rdfs:subClassOf rdf:resource="https://www.iflastandards.info/fr/frbr/frbroo#F11_Corporate_Body"/>
        <rdfs:comment xml:lang="en">A legal entity established with the goal of obtaining economic benefits. In the context of the OntoExhibit ontology, this class specifically refers to those entities dedicated to the sale, distribution, or promotion of products and services related to art. This may include commercial galleries, art consultancy firms, art supply companies, among others. It also refers to those entities not directly related to the art field, but that can act as promoters or financiers in certain exhibition projects. This class also includes those entities that play a significant role in the field of art criticism, the production/publication of curatorial texts, and, in general, cultural, intellectual, or artistic productions related to art exhibitions.</rdfs:comment>
        <rdfs:label xml:lang="en">company</rdfs:label>
        <rdfs:label xml:lang="es">compañía empresarial</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Complementary_Topic -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Complementary_Topic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Theme"/>
        <rdfs:label xml:lang="en">complementary topic</rdfs:label>
        <rdfs:label xml:lang="es">tema complementario</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Computational_Development -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Computational_Development">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E65_Creation"/>
        <rdfs:comment xml:lang="en">The &quot;Computational Development&quot; class represents the activities and processes involved in creating, designing, and implementing computational systems, software, and algorithms. This includes the development of digital tools, applications, interactive systems, and computational models that support various domains such as art, science, engineering, and education. Computational Development encompasses tasks such as coding, software engineering, system architecture, algorithm design, and testing, aimed at producing functional and innovative technological solutions.</rdfs:comment>
        <rdfs:label xml:lang="en">computational development</rdfs:label>
        <rdfs:label xml:lang="es">desarrollo computacional</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Computational_Object -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Computational_Object">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Propositional_Object"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasProduction"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Computational_Development"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Computational objects are treated as propositional objects because their design, modelling and production embed explicit or implicit propositions (e.g., data models, rules, constraints, affordances, policies, and algorithmic logics). This propositional character holds even when such objects also function under other facets (e.g., place or actant).</rdfs:comment>
        <rdfs:comment xml:lang="en">The &quot;Computational Object&quot; class represents entities created with computational languages, and processed or existing within computational systems. These objects include software, algorithms, simulations, virtual environments, AI systems, and other digital productions. Computational Objects are characterized by their creation, manipulation, and existence within digital or computational frameworks, and they play a crucial role in digital art, generative curation, and digital exhibitions. Nevertheless, this class should not be confused with artworks, cultural objects, or other work manifestations that materialize in digital format.</rdfs:comment>
        <rdfs:label xml:lang="en">computational object</rdfs:label>
        <rdfs:label xml:lang="es">objeto computacional</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Concept -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Concept">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E28_Conceptual_Object"/>
        <rdfs:comment xml:lang="en">A fundamental unit that represents an abstract idea, entity, or category that encapsulates the essential characteristics and properties of an object, event, or phenomenon.</rdfs:comment>
        <rdfs:label xml:lang="en">concept</rdfs:label>
        <rdfs:label xml:lang="es">concepto</rdfs:label>
        <owl:equivalentClass xml:lang="es">https://www.iflastandards.info/fr/frbr/frbroo#F6</owl:equivalentClass>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Conception -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Conception">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E65_Creation"/>
        <rdfs:comment xml:lang="en">Conception&quot; refers to the specific activity involved in the conceptualization of abstract, non-material objects. This class encompasses the intellectual processes and creative thinking required to develop ideas, theories, frameworks, and other intangible constructs. &quot;Conception&quot; includes activities such as brainstorming, theorizing, imagining, planning, and designing conceptual entities. It is characterized by the formulation of novel concepts, models, or solutions that exist primarily in the cognitive realm, rather than having a physical form.</rdfs:comment>
        <rdfs:label xml:lang="es">concepción</rdfs:label>
        <rdfs:label xml:lang="en">conception</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Conceptual_Work -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Conceptual_Work">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E28_Conceptual_Object"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Propositional_Entity"/>
        <rdfs:comment xml:lang="en">The intellectual and conceptual formulation of a work conceived as a coherent and unitary entity in itself. It is potentially susceptible to being realized in various expressions and/or manifestations.</rdfs:comment>
        <rdfs:label xml:lang="en">conceptual work</rdfs:label>
        <rdfs:label xml:lang="es">obra conceptual</rdfs:label>
        <owl:equivalentClass>https://www.iflastandards.info/fr/frbr/frbroo#F1</owl:equivalentClass>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Conference -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Conference">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Scholarly_Educational_Activity"/>
        <rdfs:label xml:lang="en">conference</rdfs:label>
        <rdfs:label xml:lang="es">congreso</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Conmemorative_Event -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Conmemorative_Event">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#propositional_activity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasTimeSpan"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Time_Range"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The &quot;Commemorative Event&quot; class represents a significant occasion organized to honor, remember, or celebrate an important person, event, or milestone, such as the fiftieth anniversary of Picasso&apos;s death. A Commemorative Event can encompass a variety of activities and sub-events, including exhibitions, lectures, performances, and ceremonies.</rdfs:comment>
        <rdfs:label xml:lang="en">conmemorative event</rdfs:label>
        <rdfs:label xml:lang="es">evento conmemorativo</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Consultant -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Consultant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="en">consultant</rdfs:label>
        <rdfs:label xml:lang="es">consultor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Coordinator -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Coordinator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="es">coordinador/a</rdfs:label>
        <rdfs:label xml:lang="en">coordinator</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Corporate_Body_Unit -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Corporate_Body_Unit">
        <rdfs:subClassOf rdf:resource="https://www.iflastandards.info/fr/frbr/frbroo#F11_Corporate_Body"/>
        <rdfs:comment xml:lang="en">A functional unit within a corporate organization that specializes in specific tasks or functions, forming part of the corporation&apos;s overall structure. This unit may be a department, a division, or any other segment that has defined roles and responsibilities within the corporation. This class may include instances such as: Departamento de Pintura of the Museo del Prado or Vicerrectorado de Cultural of the Universidad de Málaga.</rdfs:comment>
        <rdfs:label xml:lang="en">corporate body unit</rdfs:label>
        <rdfs:label xml:lang="es">unidad de organización corporativa</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Corporate_Visual_Branding -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Corporate_Visual_Branding">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Visual_Information_Object"/>
        <rdfs:comment>para la imagen de marca de las instituciones y corporaciones</rdfs:comment>
        <rdfs:label xml:lang="en">corporate visual branding</rdfs:label>
        <rdfs:label xml:lang="es">identidad visual corporativa</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Creator -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Creator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="es">creador</rdfs:label>
        <rdfs:label xml:lang="en">creator</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Critique -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Critique">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Proposition"/>
        <rdfs:comment xml:lang="en">In OntoExhibit, the Critique class represents a specific type of proposition that constitutes the core content of an art review or critical work. A critique provides an evaluative or interpretative perspective on artworks and exhibitions, offering insights that reflect the author&apos;s  analysis or judgment.  This class serves to distinguish the conceptual content  from its medium or context, enabling the analysis of its role in shaping discourses around art and exhibitions.</rdfs:comment>
        <rdfs:label xml:lang="en">critique</rdfs:label>
        <rdfs:label xml:lang="es">crítica</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Cultural_Center -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Cultural_Center">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Cultural_Institution"/>
        <rdfs:label xml:lang="es">centro cultural</rdfs:label>
        <rdfs:label xml:lang="en">cultural center</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Cultural_Institution -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Cultural_Institution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Institution"/>
        <rdfs:comment xml:lang="en">This class comprises institutions whose main role is the preservation, research, communication and exhibition of cultural productions, such as museums, art centers, foundations, libraries, and other cultural organizations.</rdfs:comment>
        <rdfs:label xml:lang="en">cultural institution</rdfs:label>
        <rdfs:label xml:lang="es">institución cultural</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Cultural_Work_Manifestation -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Cultural_Work_Manifestation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Work_Manifestation"/>
        <rdfs:comment xml:lang="en">The &quot;Cultural Work Manifestation&quot; class represents cultural objects and productions that fall outside the traditional Western concept of &quot;artistic&quot; objects. This class encompasses a wide range of cultural works that are significant in their own right but do not fit the specific connotations and constructions associated with the Western concept of art. Examples include traditional crafts, indigenous artifacts, cultural rituals, folkloric expressions, community-based creations, and other forms of cultural manifestations. The purpose of this class is to provide a more inclusive framework for classifying and understanding cultural productions that cannot be categorized as &quot;artworks&quot; within the Western paradigm.</rdfs:comment>
        <rdfs:label xml:lang="en">cultural work manifestation</rdfs:label>
        <rdfs:label xml:lang="es">objeto cultural</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Curation -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Curation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Conception"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasTimeSpan"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Time_Range"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The &quot;Curation&quot; class represents the process and practice of selecting, organizing, and presenting artworks and other cultural and material objects within an art exhibition. This includes all activities related to the conceptual aspects of creating a cohesive and meaningful exhibition, such as research, selection of works, thematic development, arrangement of artworks, and interpretative content.</rdfs:comment>
        <rdfs:label xml:lang="es">curación</rdfs:label>
        <rdfs:label xml:lang="en">curation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Curator -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Curator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Author"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#isRoleOf"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Human_Actant"/>
                            <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Techno-Actant"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The &quot;Curator&quot; class represents individuals or entities responsible for the conceptualization of exhibition-curatorial projects. Curators play a crucial role in the selection of exhibition themes, development of curatorial discourse, selection of exhibitors and works, and interpretation of cultural objects. Curators may work independently or as part of a team within museums, galleries, or other cultural institutions.</rdfs:comment>
        <rdfs:label xml:lang="es">comisario</rdfs:label>
        <rdfs:label xml:lang="en">curator</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Curatorial_Discourse -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Curatorial_Discourse">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Discourse"/>
        <rdfs:comment xml:lang="en">This class refers to the narrative, critical thinking, and conceptual framework developed by curators to guide the creation, organization, and interpretation of an exhibition. This discourse encompasses the thematic, theoretical, and contextual elements that shape the presentation and understanding of the artworks or artifacts on display.</rdfs:comment>
        <rdfs:label xml:lang="en">curatorial discourse</rdfs:label>
        <rdfs:label xml:lang="es">discurso curatorial</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Curatorial_Proposal -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Curatorial_Proposal">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Preliminary_Ideas"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#isPreliminaryIdeasOf"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Exhibition_Curatorial_Project"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Curatorial Proposal designates a propositional entity that sets out a curatorial project in a preliminary, projective form. It articulates the intended concept, scope, rationale, and curatorial approach—often including aims, selection principles, thematic lines, key references, and practical constraints—so that the project can be discussed, evaluated, negotiated, or commissioned prior to its realization.</rdfs:comment>
        <rdfs:label xml:lang="en">curatorial proposal</rdfs:label>
        <rdfs:label xml:lang="es">propuesta de comisariado</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Curatorial_Work -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Curatorial_Work">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Conceptual_Work"/>
        <rdfs:comment xml:lang="en">This class refers to the comprehensive conceptualization, planning, and organization of a cultural activity and production based on selection processes and narrative building. This project encompasses various actions and processes, including the conceptualization of the curatorial discourse and narrative to be unfolded, the selection of activities to be carried out or material objects to be displayed or recorded, coordination with participants, the design of the associated place (digital and/or physical), and the development of interpretative content.</rdfs:comment>
        <rdfs:label xml:lang="en">curatorial project</rdfs:label>
        <rdfs:label xml:lang="es">proyecto curatorial</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Database -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Database">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Computational_Object"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Information_Object"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Work_Manifestation"/>
        <rdfs:label xml:lang="es">base de datos</rdfs:label>
        <rdfs:label xml:lang="en">database</rdfs:label>
        <modelingNote xml:lang="en">Modeling guideline: Use Database as Information_Object (and as Computational_Object when relevant) when it is modeled primarily as an informational and/or technical resource. Add typing as Work_Manifestation only when the database is modeled as a released, citable manifestation (e.g., curated edition, versioned release, DOI or equivalent publication framing, circulation and reception).</modelingNote>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Date -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Date">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Time_Span"/>
        <rdfs:comment xml:lang="en">Temporal unit that does not imply duration. This class represents a specific point in time identified by a day, usually recorded as year, month, and day.</rdfs:comment>
        <rdfs:label xml:lang="en">date</rdfs:label>
        <rdfs:label xml:lang="es">fecha</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Designer -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Designer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Creator"/>
        <rdfs:label xml:lang="en">designer</rdfs:label>
        <rdfs:label xml:lang="es">diseñador</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Developer -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Developer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Creator"/>
        <rdfs:label xml:lang="es">desarrollador</rdfs:label>
        <rdfs:label xml:lang="en">developer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Diagramme -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Diagramme">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Visual_Information_Object"/>
        <rdfs:label xml:lang="es">diagrama</rdfs:label>
        <rdfs:label xml:lang="en">diagramme</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Digital_Place -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Digital_Place">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Techno-Place"/>
        <rdfs:comment xml:lang="en">This class comprehends a variety of digital environments such as digital platforms, websites, virtual reality (VR) environments, augmented reality (AR) spaces, and other online interfaces where technology facilitates interaction or presentation. In OntoExhibit, “digital places” also represent the digital environments where digital cultural activities, included digital exhibitions, take place. “Digital Places” may act as “Digital Sites”.</rdfs:comment>
        <rdfs:label xml:lang="en">digital place</rdfs:label>
        <rdfs:label xml:lang="es">espacio digital</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Digital_Platform -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Digital_Platform">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Digital_Place"/>
        <rdfs:comment xml:lang="en">The &quot;Digital Platform&quot; class represents large-scale technological infrastructures designed to host, manage, and support extensive digital interactions and activities. These platforms provide the backbone for a wide range of digital services and applications, facilitating complex operations and high-volume user engagement. Digital Platforms include large-scale social media networks, comprehensive cloud computing services, extensive content distribution networks, and other robust digital infrastructures that go beyond specific websites. In the art exhibitions domain, an example of a digital platform could be Europeana, which features a dedicated section for the presentation of digital exhibitions.</rdfs:comment>
        <rdfs:label xml:lang="en">digital platform</rdfs:label>
        <rdfs:label xml:lang="es">plataforma digital</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Digital_Site -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Digital_Site">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Digital_Place"/>
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Site"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Site"/>
        <rdfs:comment xml:lang="en">The &quot;Digital Site&quot; class represents specific, smaller-scale digital locations that are part of larger digital environments or platforms. These sites include individual web pages, subdomains, sections of websites, or specific interactive components within a broader digital platform. “Digital Sites” serve focused purposes within their larger digital contexts, such as hosting specific content -including digital exhibitions-, and facilitating targeted interactions, or providing specialized services.</rdfs:comment>
        <rdfs:label xml:lang="en">digital site</rdfs:label>
        <rdfs:label xml:lang="es">sitio digital</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Disciple -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Disciple">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="en">disciple</rdfs:label>
        <rdfs:label xml:lang="es">discípulo</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Discourse -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Discourse">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Proposition"/>
        <rdfs:comment xml:lang="en">An articulated set of propositions that constitutes a discursive framework (conceptual, narrative, or argumentative) through which a phenomenon in the exhibition ecosystem is defined, justified, or interpreted.</rdfs:comment>
        <rdfs:label xml:lang="en">discourse</rdfs:label>
        <rdfs:label xml:lang="es">discurso</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Dispositif -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Dispositif">
        <rdfs:comment xml:lang="en">In OntoExhibit, the &quot;Dispositif&quot; class represents a category that encompasses entities functioning as elements for documenting exhibitions, communicating information about them, facilitating their understanding, expanding their ideas, and more. This class includes various types of dispositifs such as documentation tools, communication materials, mediation activities, interpretative aids, and expansion apparatuses. A dispositif serves to enhance engagement, comprehension, expansion, and dissemination of knowledge related to exhibitions, making it a crucial component in the art exhibition domain’s discursive and social practices. Although in OntoExhibit this class is specifically designed to codify information about exhibitions, it can also be applied to other events and objects.</rdfs:comment>
        <rdfs:label xml:lang="en">dispositif</rdfs:label>
        <rdfs:label xml:lang="es">dispositivo</rdfs:label>
        <modelingNote xml:lang="en">In OntoExhibit, Dispositif classes are not intended to be mutually exclusive. A single dispositif instance may be typed under multiple functional subclasses (e.g., Communication_Dispositif and Mediation_Dispositif) when it simultaneously performs more than one function in the exhibition ecosystem. Likewise, the distinction between institutional and non-institutional dispositifs is used as a provenance facet—indicating origin, authorization, or production context—rather than as an essential ontological kind, even though it is represented through subclassing for practical querying and organization. Hybrid provenance is modeled by multiple typing: the same dispositif instance may be asserted both as Institutional Dispositif and Non-Institutional Dispositif when production, authorship, or authorization is mixed or co-produced. Undetermined cases may be left unclassified.</modelingNote>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Documentation_Dispositif -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Documentation_Dispositif">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Dispositif"/>
        <rdfs:comment xml:lang="en">The &quot;Documentation Dispositif&quot; class represents propositional objects used to document or register information, data, evidences, features, etc. with the aim of recording and preserving information about something. Classes that are susceptible to be documented are events, material objects, conceptual works, and places. Various propositional objects are typically employed for these purposes, including catalogs, records, inventories, databases, and other structured documentation systems that capture, organize, and store information. Additionally, other propositional objects can also serve this purpose, such as artworks, maps, diagrams, personal photograph albums, socially-built archives, etc., although they have not been primarily conceived or designed for this end. Therefore, this class links entities with those propositional objects that document them regardless their nature, genre, or typology.</rdfs:comment>
        <rdfs:label xml:lang="es">dispositivo de documentación</rdfs:label>
        <rdfs:label xml:lang="en">documentation dispositif</rdfs:label>
        <modelingNote xml:lang="en">This class is not disjoint with other dispositif types; see Dispositif modeling note.</modelingNote>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Editor -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Editor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="en">editor</rdfs:label>
        <rdfs:label xml:lang="es">editor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Educational_Institution -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Educational_Institution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Institution"/>
        <rdfs:comment xml:lang="en">This class comprises institutions whose main role is the education but that play a significant role in the art exhibition domain promoting, organizing or funding exhibitions.</rdfs:comment>
        <rdfs:label xml:lang="en">educational institution</rdfs:label>
        <rdfs:label xml:lang="es">institución educativa</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Emotional_Reaction -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Emotional_Reaction">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E5_Event"/>
        <rdfs:comment xml:lang="en">The &quot;Emotional Reaction&quot; class represents the emotional responses elicited by artworks, exhibitions, events, or cultural entities. This includes the range of emotions experienced by individuals, such as joy, sadness, anger, surprise, and awe, in response to artistic and cultural stimuli. Emotional Reactions are important for understanding the affective impact of cultural content on audiences and can provide valuable insights into audience engagement and reception.</rdfs:comment>
        <rdfs:label xml:lang="en">emotional reaction</rdfs:label>
        <rdfs:label xml:lang="es">reacción emocional</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#End_Of_Activity -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#End_Of_Activity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Planned_Activity"/>
        <rdfs:comment xml:lang="en">The &quot;End of Activity&quot; class represents the concluding actions or events that mark the termination of a larger activity or event. This includes closing ceremonies, final speeches, concluding performances, or any other activities that signify the end of an event or activity.</rdfs:comment>
        <rdfs:label xml:lang="en">end of activity</rdfs:label>
        <rdfs:label xml:lang="es">fin de actividad</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Exact_Date -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Exact_Date">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Date"/>
        <rdfs:comment xml:lang="en">The &quot;Exact Date&quot; class represents a specific point in time, defined with precision by a particular calendar date.</rdfs:comment>
        <rdfs:label xml:lang="en">exact date</rdfs:label>
        <rdfs:label xml:lang="es">fecha exacta</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Executive_Position -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Executive_Position">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#professional_context"/>
        <rdfs:comment xml:lang="en">Executive Position is an intermediary (reified) spatio-temporal context that models the formal appointment through which an individual holds a leadership role within an organisation. It captures the fact that executive authority is institutionally defined and time-bound, enabling the association of a person, an organisation, and the relevant role or office with a specific time range (and, where applicable, with additional qualifiers such as mandate type, status, or scope of responsibility).

In OntoExhibit, Executive Position covers cases in which an individual—such as a company CEO, the president of a professional association, or a museum director—embodies organisational authority and is accountable for strategic direction, decision-making, and institutional representation (including speaking on behalf of the organisation). By modelling these relations explicitly, the class supports the analysis of governance structures, institutional trajectories, and leadership networks within exhibition ecosystems.</rdfs:comment>
        <rdfs:label xml:lang="en">executive position</rdfs:label>
        <rdfs:label xml:lang="es">puesto ejecutivo</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Exhibition -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Exhibition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Exhibitionary_Event"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Work_Manifestation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#embodies"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Curatorial_Discourse"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasProduction"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Exhibition_Making"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasTimeSpan"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Time_Range"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The &quot;Exhibition&quot; class represents a curated display of artworks, artifacts, or cultural items presented to the public in a specific venue, such as a museum, gallery, or cultural center. Exhibitions are organized to showcase collections, promote artistic expression, educate audiences, and engage the public with cultural heritage.</rdfs:comment>
        <rdfs:label xml:lang="en">exhibition</rdfs:label>
        <rdfs:label xml:lang="es">exposición</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Exhibition_Curatorial_Project -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Exhibition_Curatorial_Project">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Curatorial_Work"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasManifestation"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Exhibition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">This class refers to the comprehensive conceptualization, planning, and organization of an art exhibition. This project encompasses various activities, including the conceptualization of the curatorial discourse, the selection of works to be displayed, the coordination with artists, the design and layout of the exhibition space, the development of interpretative content, and the formulation of audience engagement strategies.</rdfs:comment>
        <rdfs:label xml:lang="en">exhibition curatorial project</rdfs:label>
        <rdfs:label xml:lang="es">proyecto expositivo-curatorial</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Exhibition_Idea -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Exhibition_Idea">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Preliminary_Ideas"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#isPreliminaryIdeasOf"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Exhibition_Curatorial_Project"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Exhibition Idea designates a preliminary propositional entity expressing an initial concept for an exhibition. It typically outlines a core intuition—such as a theme, question, or curatorial premise—and may include early indications of scope, potential works or materials, and intended modes of presentation. It functions as an early-stage articulation that can be developed into a curatorial proposal, refined through research and discussion, or abandoned.</rdfs:comment>
        <rdfs:label xml:lang="en">exhibition idea</rdfs:label>
        <rdfs:label xml:lang="es">idea de exposición</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Exhibition_Making -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Exhibition_Making">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E12_Production"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasTimeSpan"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Time_Range"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The &quot;Exhibition Making&quot; class represents the comprehensive set of activities aimed at the effective production of an art exhibition. This encompasses the materialization of a curatorial and exhibition project, including the planning, coordination, and execution of all tasks necessary to bring the exhibition to life. Activities within Exhibition Making involve collaboration between curators, artists, designers, museographers, experts in visual branding, and other stakeholders to ensure the successful realization of the exhibition&apos;s vision.</rdfs:comment>
        <rdfs:label xml:lang="en">exhibition making</rdfs:label>
        <rdfs:label xml:lang="es">producción expositiva</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Exhibitionary_Event -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Exhibitionary_Event">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#propositional_activity"/>
        <rdfs:comment xml:lang="en">The &quot;Exhibitionary Event&quot; class represents any event specifically organized to showcase artworks, artifacts, or cultural items to the public. These events can include art exhibitions, gallery openings, art fairs, and other similar occasions where the primary focus is the presentation and viewing of curated collections.</rdfs:comment>
        <rdfs:label xml:lang="es">evento expositivo</rdfs:label>
        <rdfs:label xml:lang="en">exhibitionary event</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Exhibitor -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Exhibitor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="en">exhibitor</rdfs:label>
        <rdfs:label xml:lang="es">expositor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Expansion_Dispositif -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Expansion_Dispositif">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Dispositif"/>
        <rdfs:comment xml:lang="en">The &quot;Expansion Dispositif&quot; class represents propositional objects and activities used to expand the interpretation, readings, understanding, and overall comprehension of cultural activities and productions. These dispositifs include supplementary materials, interactive media, extended narratives, academic publications, discussion forums, and other materials and activities designed to deepen and broaden the audience&apos;s engagement and understanding of the cultural activities and productions. Additionally, other propositional objects and activities can also serve this purpose. Therefore, this class links cultural activities and productions with those propositional objects and activities that expand their understanding and interpretations, regardless of their nature, genre, or typology.</rdfs:comment>
        <rdfs:label xml:lang="es">dispositivo de expansión</rdfs:label>
        <rdfs:label xml:lang="en">expansion dispositif</rdfs:label>
        <modelingNote xml:lang="en">This class is not disjoint with other dispositif types; see Dispositif modeling note.</modelingNote>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Fair -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Fair">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Exhibitionary_Event"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasTimeSpan"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Time_Range"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The &quot;Art Fair&quot; class represents a type of &quot;Exhibitionary Event&quot; that brings together multiple galleries, artists, and exhibitors to showcase and sell artworks in a single venue. Art fairs are typically large-scale events that attract collectors, critics, curators, and the general public. These events often include a variety of programs such as exhibitions, talks, panel discussions, and performances, providing a dynamic platform for the art market and fostering cultural exchange.</rdfs:comment>
        <rdfs:label xml:lang="en">art fair</rdfs:label>
        <rdfs:label xml:lang="es">feria de arte</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#FamilyWorkshop -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#FamilyWorkshop">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Workshop"/>
        <rdfs:label xml:lang="en">family workshop</rdfs:label>
        <rdfs:label xml:lang="es">taller familiar</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Film_Proyection -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Film_Proyection">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Scholarly_Educational_Activity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasTimeSpan"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">film proyection</rdfs:label>
        <rdfs:label xml:lang="es">proyección de cine</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Foundation -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Foundation">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E65_Creation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasTimeSpan"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The &quot;Foundation&quot; class represents the act of establishing institutions, organizations, groups, or other entities. In the context of art and cultural heritage, this includes the creation of museums, galleries, art collectives, cultural institutions, and similar entities. The foundation process involves legal, administrative, and/or organizational activities necessary to formally create and sustain these entities, ensuring they can operate and achieve their missions.</rdfs:comment>
        <rdfs:label xml:lang="en">foundation</rdfs:label>
        <rdfs:label xml:lang="es">fundación</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Founder -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Founder">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Creator"/>
        <rdfs:label xml:lang="en">founder</rdfs:label>
        <rdfs:label xml:lang="es">fundador</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Funder -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Funder">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#isRoleOf"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Human_Actant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">financiador</rdfs:label>
        <rdfs:label xml:lang="en">funder</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Gallery -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Gallery">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Company"/>
        <rdfs:comment xml:lang="en">An organizational entity dedicated to exhibiting and marketing works of art. Art galleries play a crucial role in the art ecosystem, acting as intermediaries between artists and the public, and often contribute to the development of artistic careers and the fostering of contemporary art trends.</rdfs:comment>
        <rdfs:label xml:lang="en">art gallery</rdfs:label>
        <rdfs:label xml:lang="es">galería de arte</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Government_Organization -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Government_Organization">
        <rdfs:subClassOf rdf:resource="https://www.iflastandards.info/fr/frbr/frbroo#F11_Corporate_Body"/>
        <rdfs:comment xml:lang="en">This class represents organizations that are part of the public sector and are responsible for implementing government policies, providing public services, and managing public resources. This class includes entities such as municipalities, ministries, regional governments, and other governmental bodies.</rdfs:comment>
        <rdfs:label xml:lang="en">government organization</rdfs:label>
        <rdfs:label xml:lang="es">organización gubernamental</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Graphic_Designer -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Graphic_Designer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Designer"/>
        <rdfs:label xml:lang="es">diseñador/a gráfico</rdfs:label>
        <rdfs:label xml:lang="en">graphic designer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Guided_Tour -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Guided_Tour">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Scholarly_Educational_Activity"/>
        <rdfs:label xml:lang="en">guided tour</rdfs:label>
        <rdfs:label xml:lang="es">visita comentada</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Hashtag -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Hashtag">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Linguistic_Information_Object"/>
        <rdfs:label xml:lang="en">hashtag</rdfs:label>
        <rdfs:label xml:lang="es">hashtag</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Hoja_de_Sala -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Hoja_de_Sala">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Linguistic_Information_Object"/>
        <rdfs:label xml:lang="en">gallery sheet</rdfs:label>
        <rdfs:label xml:lang="es">hoja de sala</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Human_Actant -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Human_Actant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Actant"/>
        <rdfs:comment xml:lang="en">This class comprises actants that are human beings.</rdfs:comment>
        <rdfs:label xml:lang="es">actante humano</rdfs:label>
        <rdfs:label xml:lang="en">human actant</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Illustrator -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Illustrator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Creator"/>
        <rdfs:label xml:lang="en">illustrator</rdfs:label>
        <rdfs:label xml:lang="es">ilustrador</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Infographic -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Infographic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Visual_Information_Object"/>
        <rdfs:label xml:lang="es">infografía</rdfs:label>
        <rdfs:label xml:lang="en">infoographic</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Information_Object -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Information_Object">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Propositional_Object"/>
        <rdfs:comment xml:lang="en">The &quot;Informational Object&quot; class represents entities that primarily consist of data or information, designed to convey knowledge, facts, instructions, or messages. Informational Objects can include documents, digital files, databases, manuals, maps, and other forms of recorded information. They serve as vehicles for the storage, transmission, and presentation of knowledge across various mediums and formats. This class is not equivalent to the E73 Information Object class of the CIDOC-CRM model, as in this reference model, this class is considered a subclass of Conceptual Object, thereby ignoring their material conditions.</rdfs:comment>
        <rdfs:label xml:lang="en">information object</rdfs:label>
        <rdfs:label xml:lang="es">objeto de información</rdfs:label>
        <modelingNote xml:lang="en">Informational Object is used to assert an informational reading of an entity (it is treated as an information-bearing vehicle). This typing is not exclusive: the same entity may also be typed under other classes when a different modeling commitment is intended (e.g., when it is modeled as a publishable/citable manifestation). In ambiguous cases such as catalogs and databases, use Informational Object for their informational function, and add the additional typing only when the modeling explicitly addresses publication framing (edition/release/versioning), circulation, and reception.</modelingNote>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Institution -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Institution">
        <rdfs:subClassOf rdf:resource="https://www.iflastandards.info/fr/frbr/frbroo#F11_Corporate_Body"/>
        <rdfs:comment xml:lang="en">This class comprises non-profit corporate bodies. In the context of the OntoExhibit ontology, it refers those institutions that play a significant role in the art exhibition domain in its multiple dimensions. Instances of this class are Museo del Prado, Google Art and Culture, Europeana, Library of Congress, etc.</rdfs:comment>
        <rdfs:label xml:lang="es">institución</rdfs:label>
        <rdfs:label xml:lang="en">institution</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Institutional_Communication_Dispositif -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Institutional_Communication_Dispositif">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Communication_Dispositif"/>
        <rdfs:comment xml:lang="en">The &quot;Institutional Communication Dispositif&quot; class represents official materials and events used by institutions to communicate and disseminate information about cultural activities and productions. These dispositifs function as authoritative sources of information, providing legitimacy and formal recognition to the messages conveyed. Examples include institutional press releases, official brochures, institutional websites, social media channels managed by the institution, newsletters, and other structured communication systems.</rdfs:comment>
        <rdfs:label xml:lang="es">dispositivo de comunicación institucional</rdfs:label>
        <rdfs:label xml:lang="en">institutional communication dispositif</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Institutional_Documentation_Dispositif -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Institutional_Documentation_Dispositif">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Documentation_Dispositif"/>
        <rdfs:comment xml:lang="en">The &quot;Institutional Documentation Dispositif&quot; class represents official documentation tools and mechanisms used by institutions to record, organize, and legitimize information about events, activities, and objects. These dispositifs function as authoritative sources of information, providing legitimacy and formal recognition to the documented entities. Examples include official records, registries, institutional databases, and certified archival materials. The institutional nature of these dispositifs underscores their role in establishing and maintaining authoritative narratives and histories within the institutional framework.</rdfs:comment>
        <rdfs:label xml:lang="es">dispositivo de documentación institucional</rdfs:label>
        <rdfs:label xml:lang="en">institutional documentation dispositif</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Institutional_Expansion_Dispositif -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Institutional_Expansion_Dispositif">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Expansion_Dispositif"/>
        <rdfs:comment xml:lang="en">The &quot;Institutional Expansion Dispositif&quot; class represents official materials and activities used by institutions to expand the interpretations, readings, discourses, ideas, and understanding of cultural events and objects. These dispositifs function as authoritative mechanisms for broadening and deepening the understanding and engagement with cultural content. Examples include institutional publications, official social media campaigns, lectures, academic conferences, and collaborative projects with other cultural or educational institutions. The institutional nature of these dispositifs underscores their role in delivering institutionally legitimized means for enriching and expanding the cultural narrative and intellectual engagement.</rdfs:comment>
        <rdfs:label xml:lang="es">dispositivo de expansión institucional</rdfs:label>
        <rdfs:label xml:lang="en">institutional expansion dispositif</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Institutional_Mediation_Dispositif -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Institutional_Mediation_Dispositif">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Mediation_Dispositif"/>
        <rdfs:comment xml:lang="en">The &quot;Institutional Mediation Dispositif&quot; class represents official materials and activities used by institutions to facilitate the interpretation, understanding, and engagement with cultural activities and productions. These dispositifs function as authoritative mechanisms for guiding public interaction with cultural content, providing structured and sanctioned methods of mediation. Examples include institutional educational programs, guided tours, official exhibition catalogs, interpretive panels, interactive displays, and workshops organized by the institution. The institutional nature of these dispositifs underscores their role in institutionally approved interpretations and educational content to the public.</rdfs:comment>
        <rdfs:label xml:lang="es">dispositivo de mediación institucional</rdfs:label>
        <rdfs:label xml:lang="en">institutional mediation dispositif</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Instructor -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Instructor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="en">instructor</rdfs:label>
        <rdfs:label xml:lang="es">instructor/a</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Interpretation -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Interpretation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Proposition"/>
        <rdfs:comment xml:lang="en">An interpretive proposition: a statement that assigns meaning or a reading to an entity, set, or situation, potentially coexisting with alternative interpretations.</rdfs:comment>
        <rdfs:label xml:lang="es">interpretación</rdfs:label>
        <rdfs:label xml:lang="en">interpretation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Interpretation_Assignment -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Interpretation_Assignment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Proposition_Assignment"/>
        <rdfs:comment xml:lang="en">The &quot;Interpretation Assignment&quot; class represents the act or process of assigning a specific interpretation, meaning, or analysis to an entity or work. This class encompasses various activities involved in the contextualization, explanation, and understanding of an entity&apos;s significance, including the assignment of thematic, historical, cultural, or conceptual interpretations. Interpretation Assignments can be applied to artworks, texts, events, or any other entities that require deeper analysis and understanding.</rdfs:comment>
        <rdfs:label xml:lang="es">asignación de interpretación</rdfs:label>
        <rdfs:label xml:lang="en">interpretation assignment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Interpretation_Center -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Interpretation_Center">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Cultural_Institution"/>
        <rdfs:label xml:lang="es">centro de interpretación</rdfs:label>
        <rdfs:label xml:lang="en">interpretation center</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Label -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Label">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Linguistic_Information_Object"/>
        <rdfs:label xml:lang="es">cartela</rdfs:label>
        <rdfs:label xml:lang="en">label</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Lecture -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Lecture">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Scholarly_Educational_Activity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasTimeSpan"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">conferencia</rdfs:label>
        <rdfs:label xml:lang="en">lecture</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Lecturer -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Lecturer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="es">conferenciante</rdfs:label>
        <rdfs:label xml:lang="en">lecturer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Lender -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Lender">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#isRoleOf"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Human_Actant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">lender</rdfs:label>
        <rdfs:label xml:lang="es">prestador</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Library -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Library">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Cultural_Institution"/>
        <rdfs:label xml:lang="es">biblioteca</rdfs:label>
        <rdfs:label xml:lang="en">library</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Linguistic_Information_Object -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Linguistic_Information_Object">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Information_Object"/>
        <rdfs:label xml:lang="en">linguistic information object</rdfs:label>
        <rdfs:label xml:lang="es">objeto de información lingüística</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Literary_Work_Manifestation -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Literary_Work_Manifestation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Work_Manifestation"/>
        <rdfs:label xml:lang="en">literary work</rdfs:label>
        <rdfs:label xml:lang="es">obra literaria</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Location -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Location">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#institutional_context"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasPlaceOfLocation"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Techno-Place"/>
                                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Territorial_Entity"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasPlaceOfLocation"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Techno-Place"/>
                                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Territorial_Entity"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Location is an intermediary (reified) spatio-temporal context that links a collective actant (e.g., a group, community, or corporate body) to the place(s) where it is situated during a specific time range. It is designed to represent organisational location as historically variable rather than as a fixed attribute, allowing multiple location records to coexist for the same entity across different periods.

In OntoExhibit, Location is primarily used to connect collective actants to geographical territories or techno-digital places that function as their institutional points of presence (for example, a headquarters city and an official website or platform). This makes it possible to describe complementary forms of location—physical and techno-digital—without conflating them with broader activity geographies. In contrast to Place of Activity, which captures the distributed set of places where an actant operates professionally, Location captures where an organisation is formally situated in a given period; for individual actants, the analogous biographical construct is Residency.</rdfs:comment>
        <rdfs:label xml:lang="es">emplazamiento</rdfs:label>
        <rdfs:label xml:lang="en">location</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Main_Topic -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Main_Topic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Theme"/>
        <rdfs:label xml:lang="en">main topic</rdfs:label>
        <rdfs:label xml:lang="es">tema central</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Material_Object -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Material_Object">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Object"/>
        <rdfs:comment xml:lang="en">The &quot;Material Object&quot; class encompasses entities that have a material existence in the world, either as physical objects or as formal realizations or materializations of ideas, concepts, etc. This class includes both physical and digital entities, as well as entities that exist solely as formal expressions, such as a poem or a melody. Material Objects are characterized by their tangible or representational form, making them accessible to perception, interaction, or representation.</rdfs:comment>
        <rdfs:label xml:lang="en">material object</rdfs:label>
        <rdfs:label xml:lang="es">objeto material</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Media_Company -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Media_Company">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Company"/>
        <rdfs:label xml:lang="es">empresa de medios de comunicación</rdfs:label>
        <rdfs:label xml:lang="en">media company</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Mediation_Dispositif -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Mediation_Dispositif">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Dispositif"/>
        <rdfs:comment xml:lang="en">The &quot;Mediation Dispositif&quot; class represents propositional objects and activities used to facilitate the interpretation, understanding, and engagement with cultural activities and productions. These dispositifs typically include educational materials, guided tours, interactive displays, workshops, and other structured systems or tools that mediate the relationship between the audience and the cultural activity and production. Additionally, other propositional objects and activities can also serve this purpose. Therefore, this class links cultural activities and productions with those propositional objects and activities that mediate with the audience, regardless of their nature, genre, or typology.</rdfs:comment>
        <rdfs:label xml:lang="es">dispositivo de mediación</rdfs:label>
        <rdfs:label xml:lang="en">mediation dispositif</rdfs:label>
        <modelingNote xml:lang="en">This class is not disjoint with other dispositif types; see Dispositif modeling note.</modelingNote>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Meeting -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Meeting">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Scholarly_Educational_Activity"/>
        <rdfs:label xml:lang="es">encuentro</rdfs:label>
        <rdfs:label xml:lang="en">meeting</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Member -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Member">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="en">member</rdfs:label>
        <rdfs:label xml:lang="es">miembro</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Membership -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Membership">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#professional_context"/>
        <rdfs:comment xml:lang="en">Membership is an intermediary (reified) spatio-temporal context that models the relationship by which an individual or collective human actant participates as a member of a group or corporate body. It represents membership as historically contingent rather than permanent, allowing the association of the member and the membership organisation with a defined time range and, where relevant, with additional qualifying terms (e.g., type of membership, status, or conditions of participation). In OntoExhibit, Membership supports the analysis of institutional and collective engagement by making membership explicit, queryable, and comparable across different organisations and periods.

This class is broader than foaf:membershipClass, which constrains membership organisations to instances of foaf:Group. In OntoExhibit, the category of Collective Human Actant encompasses both groups and corporate bodies, and either may function as a membership organisation; Membership therefore provides a more flexible pattern aligned with exhibition ecosystems and their heterogeneous organisational forms.</rdfs:comment>
        <rdfs:label xml:lang="en">membership</rdfs:label>
        <rdfs:label xml:lang="es">membresía</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Museographer -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Museographer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#isRoleOf"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://cidoc-crm.org/cidoc-crm/7.1.1/E21_Person"/>
                            <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Museographic_Firm"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">museographer</rdfs:label>
        <rdfs:label xml:lang="es">museógrafo/a</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Museographic_Collection -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Museographic_Collection">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Cultural_Institution"/>
        <rdfs:label xml:lang="es">colección museográfica</rdfs:label>
        <rdfs:label xml:lang="en">museographic collection</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Museographic_Firm -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Museographic_Firm">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Company"/>
        <rdfs:label xml:lang="es">firma de museografía</rdfs:label>
        <rdfs:label xml:lang="en">museographic firm</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Museum -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Museum">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Cultural_Institution"/>
        <rdfs:label xml:lang="es">museo</rdfs:label>
        <rdfs:label xml:lang="en">museum</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Music_Event -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Music_Event">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Scholarly_Educational_Activity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasTimeSpan"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">evento musical</rdfs:label>
        <rdfs:label xml:lang="en">music event</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Narrative_Structure -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Narrative_Structure">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Organization_Schema"/>
        <rdfs:comment xml:lang="en">An ordering structure that organizes an intellectual work through discursive and/or narrative segmentation (e.g., chapters, sections, thematic units) and their relations. It frames how propositions are developed, distributed, or accumulated across the work’s parts.</rdfs:comment>
        <rdfs:label xml:lang="es">estructura narrativa</rdfs:label>
        <rdfs:label xml:lang="en">narrative structure</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Narrative_Thematic_Unit -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Narrative_Thematic_Unit">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E28_Conceptual_Object"/>
        <rdfs:comment xml:lang="en">The discursive and/or narrative parts through which an intellectual work is articulated. This is an explicit segmentation that may develop one or more propositions.</rdfs:comment>
        <rdfs:label xml:lang="en">narrative/discursive unit</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Natural_Landscape -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Natural_Landscape">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#physical_place"/>
        <rdfs:label xml:lang="es">espacio natural</rdfs:label>
        <rdfs:label xml:lang="en">natural landscape</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Natural_Object -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Natural_Object">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Non_Produced_Material_Object"/>
        <rdfs:comment xml:lang="en">The &quot;Natural Object&quot; class represents entities that occur naturally in the environment. These objects are not created by humans or technological processes, and include a wide range of naturally occurring materials and formations such as rocks, minerals, plants, fossils, and other elements found in nature. Natural objects can be part of art exhibitions. They may be exhibited for their intrinsic beauty, scientific interest, or cultural significance. Therefore, they can also be integral components of artworks or art installations.</rdfs:comment>
        <rdfs:label xml:lang="en">natural object</rdfs:label>
        <rdfs:label xml:lang="es">objeto de la naturaleza</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Non-Institutional_Communication_Dispositif -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Non-Institutional_Communication_Dispositif">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Communication_Dispositif"/>
        <rdfs:comment xml:lang="en">The &quot;Non-Institutional Communication Dispositif&quot; class represents unofficial materials and events used to communicate and disseminate information about cultural activities and productions. These dispositifs often include contributions from individuals, artists, independent groups, and grassroots organizations. They may reflect personal perspectives or community-driven initiatives. Examples include personal blogs, independent social media posts, artist statements, community newsletters, zines, and other forms of informal communication. The non-institutional nature of these dispositifs underscores their role in offering diverse and decentralized forms of communication within the cultural sector.</rdfs:comment>
        <rdfs:label xml:lang="es">dispositivo de comunicación no institucional</rdfs:label>
        <rdfs:label xml:lang="en">non-institutional communication dispositif</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Non-Institutional_Documentation_Dispositif -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Non-Institutional_Documentation_Dispositif">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Documentation_Dispositif"/>
        <rdfs:comment xml:lang="en">The &quot;Non-Institutional Documentation Dispositif&quot; class represents unofficial documentation tools and mechanisms used to record and interpret information about events, activities, and objects. These dispositifs often include socially constructed materials, contributions from artists, and other informal or non-official sources. They may reflect personal perspectives, creative interpretations, or community-generated content, providing alternative narratives and insights that complement or challenge institutional records. Examples include personal archives, artist&apos;s notebooks, community-led documentation projects, and other forms of grassroots or independent documentation.</rdfs:comment>
        <rdfs:label xml:lang="es">dispositivo de documentación no institucional</rdfs:label>
        <rdfs:label xml:lang="en">non-institutional documentation dispositif</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Non-Institutional_Expansion_Dispositif -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Non-Institutional_Expansion_Dispositif">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Expansion_Dispositif"/>
        <rdfs:comment xml:lang="en">The &quot;Non-Institutional Expansion Dispositif&quot; class represents informal tools, materials, and activities used to expand the interpretations, readings, discourses, ideas, and understanding of cultural events or objects. These dispositifs are often created and distributed by individuals, artists, independent groups, or grassroots organizations. They provide alternative and diverse methods for broadening and deepening engagement with cultural content, reflecting personal perspectives, creative interpretations, or community-driven initiatives. Examples include independent publications, artist-led discussions, community workshops, blogs, zines, and other informal media. The non-institutional nature of these dispositifs underscores their role in offering varied and decentralized forms of expanding cultural narratives and intellectual engagement.</rdfs:comment>
        <rdfs:label xml:lang="es">dispositivo de expansión no institucional</rdfs:label>
        <rdfs:label xml:lang="en">non-institutional expansion dispositif</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Non-Institutional_Mediation_Dispositif -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Non-Institutional_Mediation_Dispositif">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Mediation_Dispositif"/>
        <rdfs:comment xml:lang="en">The &quot;Non-Institutional Mediation Dispositif&quot; class represents informal tools, materials, and activities used to facilitate the interpretation, understanding, and engagement with cultural activities and productions. These dispositifs are often created and distributed by individuals, artists, independent groups, or grassroots organizations. They provide alternative and diverse methods of mediation that reflect personal perspectives, creative interpretations, or community-driven initiatives. Examples include artist-led workshops, independent guided tours, personal blogs, community discussion groups, zines, and other forms of informal mediation. The non-institutional nature of these dispositifs underscores their role in offering varied and decentralized forms of mediation that complement or challenge official narratives.</rdfs:comment>
        <rdfs:label xml:lang="es">dispositivo de mediación no institucional</rdfs:label>
        <rdfs:label xml:lang="en">non-institutional mediation dispositif</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Non_Human_Actant -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Non_Human_Actant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Actant"/>
        <rdfs:comment xml:lang="en">A non-human entity that plays an active role in the realm of art exhibitions. This may include biological entities, such as animals and plants, as well as inanimate objects, that actively participate in the creation, interpretation, or presentation of artworks and cultural productions. This class is essential for addressing the participation of non-human entities that affect or contribute to artistic dynamics in significant ways. For example, an installation may include living plants, where their biological processes (such as growth, photosynthesis, and response to light stimuli) are monitored and used to alter other elements of the installation, such as lighting, sounds, or visual projections. Sensors placed on the plants detect changes in their environment (such as humidity, temperature, and light) and these data trigger modifications in the installation, creating an environment that is co-created by the biological activity of the plants. This class does not comprise technological entities which, in the context of the OntoExhibit ontology, are considered to inherently carry a human component in their design, conceptualization, and execution. See “Techno-Actant” class.</rdfs:comment>
        <rdfs:label xml:lang="es">actante no humano</rdfs:label>
        <rdfs:label xml:lang="en">non-human actant</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Non_Produced_Material_Object -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Non_Produced_Material_Object">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Material_Object"/>
        <rdfs:comment xml:lang="en">The Non-Produced Material Object class represents entities that have a material existence but have not been intentionally created or manufactured. These objects occur naturally or exist independently of production. Non-Produced Material Objects include natural artifacts and biological organisms without deliberate intervention or creation.</rdfs:comment>
        <rdfs:label xml:lang="en">non-produced material object</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Non_Propositional_Object -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Non_Propositional_Object">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Produced_Material_Object"/>
        <rdfs:comment xml:lang="en">The &quot;Non-Propositional Object&quot; class represents material entities that do not primarily serve as realizations of ideas, concepts, or conceptual works. Unlike Propositional Objects, Non-Propositional Objects are not characterized by their semantic nature. Instead, they exist primarily for their physical or digital properties, or utilitarian functions. These objects can include items and devices whose primary significance is not tied to conveying meaning or expressing concepts or ideas.</rdfs:comment>
        <rdfs:label xml:lang="en">non-propositional object</rdfs:label>
        <rdfs:label xml:lang="es">objeto no proposicional</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Object -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Object">
        <rdfs:label xml:lang="en">object</rdfs:label>
        <rdfs:label xml:lang="es">objeto</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Open_Day -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Open_Day">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Communication_Activity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasTimeSpan"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The &quot;Open Day&quot; class represents an event where an institution, such as a museum, gallery, or cultural organization, opens its doors to the public, often free of charge, to provide access to exhibitions, facilities, and special activities. Open Days are designed to engage the community, attract new visitors, and provide educational and recreational opportunities. These events typically include guided tours, workshops, performances, and interactive sessions to enhance the visitor experience.</rdfs:comment>
        <rdfs:label xml:lang="es">jornada de puertas abiertas</rdfs:label>
        <rdfs:label xml:lang="en">open day</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Opening -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Opening">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Beginning_Of_Activity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasTimeSpan"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">inauguración</rdfs:label>
        <rdfs:label xml:lang="en">opening</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Organization_Schema -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Organization_Schema">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E28_Conceptual_Object"/>
        <rdfs:comment xml:lang="en">An abstract organization schema that specifies how parts, units, or elements are arranged and related within an intellectual work or exhibition-related articulation. It provides an explicit pattern of ordering (e.g., sequences, groupings, hierarchies, modules) through which content can be structured, independently of the media or dispositifs through which it may later be realized.</rdfs:comment>
        <rdfs:label xml:lang="es">estructura de ordenación</rdfs:label>
        <rdfs:label xml:lang="en">ordering structure</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Organizer -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Organizer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#isRoleOf"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Human_Actant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">organizador</rdfs:label>
        <rdfs:label xml:lang="en">organizer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Outdoor_Area -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Outdoor_Area">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#physical_place"/>
        <rdfs:label xml:lang="es">espacio exterior</rdfs:label>
        <rdfs:label xml:lang="en">outdoor area</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Owner -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Owner">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="en">owner</rdfs:label>
        <rdfs:label xml:lang="es">propietario</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Participant -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Participant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="en">participant</rdfs:label>
        <rdfs:label xml:lang="es">participante</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Physical_Site -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Physical_Site">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Site"/>
                    <rdf:Description rdf:about="https://w3id.org/OntoExhibit#physical_place"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Site"/>
        <rdfs:comment xml:lang="en">This class represents physical sites.</rdfs:comment>
        <rdfs:label xml:lang="es">lugar físico</rdfs:label>
        <rdfs:label xml:lang="en">physical site</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Place_Of_Residence -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Place_Of_Residence">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#biographical_context"/>
        <rdfs:comment xml:lang="en">Residency is an intermediary (reified) spatio-temporal context that links a person to a place where they reside for a given time range. It is designed to represent residential history as a sequence of time-qualified relations rather than as a fixed attribute, allowing multiple residences to be recorded for the same individual across different periods. By capturing when and where a person lived, Residency supports the analysis of biographical trajectories, mobility patterns, and the spatial distribution of life contexts over time.</rdfs:comment>
        <rdfs:label xml:lang="es">residencia</rdfs:label>
        <rdfs:label xml:lang="en">residency</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Planned_Activity -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Planned_Activity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Activity"/>
        <rdfs:comment xml:lang="en">The &quot;Planned Activity&quot; class represents any type of event that is systematically scheduled and organized ahead of time, often of significant interest, that takes place at a specific time and location. This includes a wide range of activities such as exhibitions, performances, lectures, workshops, openings, and other cultural or social gatherings. These activities are characterized by their temporality, purpose, and the involvement of participants or an audience. They are organized to achieve specific objectives, such as education, entertainment, community engagement, or celebration.</rdfs:comment>
        <rdfs:label xml:lang="es">actividad programada</rdfs:label>
        <rdfs:label xml:lang="en">planned activity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Preliminary_Ideas -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Preliminary_Ideas">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E28_Conceptual_Object"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Propositional_Entity"/>
        <rdfs:comment xml:lang="en">The &quot;Preliminary Ideas&quot; class represents the initial and preliminary concepts, thesis, arguments, hypothesis… that precede and ground the conception of a complete work. This can materialize as drafts, sketches, briefings, provisional reports, and other preparatory documents and artifacts. Preliminary Ideas serve as the foundational elements and exploratory steps in the conceptual, intellectual, and creative process, capturing the early stages of ideation, planning, and conceptual development. This class enables the analysis of changes and modifications experienced by works during their conceptualization process.</rdfs:comment>
        <rdfs:label xml:lang="es">ideas preliminares</rdfs:label>
        <rdfs:label xml:lang="en">preliminary ideas</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Preliminary_Propositional_Object -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Preliminary_Propositional_Object">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Propositional_Object"/>
        <rdfs:comment xml:lang="en">The &quot;Preliminary Propositional Object&quot; class represents entities that capture initial ideas, drafts, sketches, and other preliminary forms of a conceptual work. These objects are characterized by their formative nature, documenting the early stages of the creative or planning process. Preliminary Propositional Objects are crucial for understanding the development and evolution of a work, as they provide insights into the creator&apos;s thought process, experimentation, and conceptual groundwork. Examples include draft manuscripts, rough sketches, conceptual diagrams, provisional reports, and brainstorming notes.</rdfs:comment>
        <rdfs:label xml:lang="es">objeto proposicional preliminar</rdfs:label>
        <rdfs:label xml:lang="en">preliminary propositional object</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Press_Event -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Press_Event">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Communication_Activity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasTimeSpan"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The &quot;Press Event&quot; class represents a media-focused event organized to provide information, announcements, or updates to journalists, media representatives, and other stakeholders. This includes press conferences, media briefings, and other events specifically designed to engage the press and provide them with the necessary materials and information to report on exhibitions, new acquisitions, significant developments, or special events.</rdfs:comment>
        <rdfs:label xml:lang="en">press conference</rdfs:label>
        <rdfs:label xml:lang="es">rueda de prensa</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Press_Release -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Press_Release">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Linguistic_Information_Object"/>
        <rdfs:label xml:lang="en">press release</rdfs:label>
        <rdfs:label>nota de prensa</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Produced_Material_Object -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Produced_Material_Object">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Material_Object"/>
        <rdfs:comment xml:lang="en">The &quot;Produced Material Object&quot; class represents material objects that have been intentionally brought into material existence or manufactured through human effort or technological processes, with potential collaboration of non-human agents. These objects encompass a wide range of items, including physical artifacts, digital products, and formal expressions of ideas or concepts. Produced Material Objects are characterized by their origin in a production process, which can involve artistic creation, industrial manufacturing, digital rendering, computational programming, or other forms of materialization.</rdfs:comment>
        <rdfs:label xml:lang="en">produced material object</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Producer -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Producer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="en">producer</rdfs:label>
        <rdfs:label xml:lang="es">productor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Professional_Association -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Professional_Association">
        <rdfs:subClassOf rdf:resource="https://www.iflastandards.info/fr/frbr/frbroo#F11_Corporate_Body"/>
        <rdfs:comment xml:lang="en">An organizational entity that unites individuals from a specific profession with the aim of supporting continuous professional development, and representing the interests of its members in the public sphere. Examples of professional associations relevant in the art exhibition domain are “Asociación de Artistas Visuales (AAV)” or “Asociación de Galerías de Arte de Andalucía (AGAA).</rdfs:comment>
        <rdfs:label xml:lang="es">asociación profesional</rdfs:label>
        <rdfs:label xml:lang="en">professional association</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Project_Director -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Project_Director">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="es">director/a de proyecto</rdfs:label>
        <rdfs:label xml:lang="en">project director</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Promoter -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Promoter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="en">promoter</rdfs:label>
        <rdfs:label xml:lang="es">promotor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Proposition -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Proposition">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E28_Conceptual_Object"/>
        <rdfs:comment xml:lang="en">This class refers to a semantic, intellectual, or conceptual element that articulates specific ideas. It can take the form of assertions, theses, hypotheses, arguments, interpretations, among others. Propositions are inherently part of &quot;propositional entities.&quot; They can be developed through “conceptual works”, conveyed and embodied in propositional objects, and assigned to any entity.</rdfs:comment>
        <rdfs:label xml:lang="es">proposición</rdfs:label>
        <rdfs:label xml:lang="en">proposition</rdfs:label>
        <modelingNote xml:lang="en">Proposition is propositional content. It is related to conceptual objects  via conveys and for propositional objects via embodies.</modelingNote>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Proposition_Assignment -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Proposition_Assignment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Assignment"/>
        <rdfs:comment xml:lang="en">The &quot;Proposition Assignment&quot; class represents the action of assigning a proposition, which can include interpretations, valuations, critical assessment, or other similar statements to an entity. This process involves linking specific propositions to artworks, exhibitions, objects, or any relevant subjects, thereby providing additional context, meaning, or evaluation. Proposition assignments are essential for enriching the understanding and appreciation of entities within the domain, facilitating scholarly analysis, and supporting curatorial decisions.</rdfs:comment>
        <rdfs:label xml:lang="es">asignación de proposición</rdfs:label>
        <rdfs:label xml:lang="en">proposition assignment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Propositional_Entity -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Propositional_Entity">
        <rdfs:comment xml:lang="en">The &quot;Propositional Entity&quot; class represents any entity, whether conceptual, material, or activity-based, that conveys, embodies, or entails some form of proposition. This proposition can be intentional and explicit or implicit. Propositional Entities encompass a wide range of forms, including artworks, exhibitions, catalogs, literary works, scholarly works, performances, lectures, conferences, and other entities that communicate or represent specific meanings, concepts, or messages. These entities are characterized by their capacity to convey and embody propositional content, which may involve thesis, hypotheses, interpretations, critical discussions, etc.</rdfs:comment>
        <rdfs:label xml:lang="es">entidad proposicional</rdfs:label>
        <rdfs:label xml:lang="en">propositional entity</rdfs:label>
        <modelingNote xml:lang="en">Propositional_Entity is used as a transversal category for entities that bear one or more propositions as their propositional content. It does not introduce a separate “kind” of thing, but marks a shared capacity across different branches of the ontology (e.g., conceptual works, preliminary ideas, propositional objects, or planned activities) to be related to Proposition.</modelingNote>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Propositional_Object -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Propositional_Object">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Produced_Material_Object"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Propositional_Entity"/>
        <rdfs:comment xml:lang="en">The &quot;Propositional Object&quot; class represents material entities that are realizations of ideas, concepts, or conceptual works. Propositional Objects are characterized by their semantic nature. They convey meaning, express intellectual concepts, or articulate discourses. They can take the form of physical objects, formal expressions, or digital entities.</rdfs:comment>
        <rdfs:label xml:lang="es">objeto proposicional</rdfs:label>
        <rdfs:label xml:lang="en">propositional object</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Public -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Public">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="en">public</rdfs:label>
        <rdfs:label xml:lang="es">público</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Publication -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Publication">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E12_Production"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#takesPlaceAt"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Territorial_Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">This class comprises the processes and activities of publishing. This process involves various stages, including the creation, editing, design, printing or digital formatting. Publication brings into material existence propositional objects in the form of books, journals, articles, reports, catalogs, brochures, and digital content such as e-books or online articles.</rdfs:comment>
        <rdfs:label xml:lang="es">publicación</rdfs:label>
        <rdfs:label xml:lang="en">publication</rdfs:label>
        <owl:equivalentClass rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.iflastandards.info/fr/frbr/frbroo#F30</owl:equivalentClass>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Publisher -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Publisher">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Company"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="en">Publisher</rdfs:label>
        <rdfs:label xml:lang="es">editor (publisher)</rdfs:label>
        <rdfs:label xml:lang="es">firma editorial</rdfs:label>
        <rdfs:label xml:lang="en">publisher</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Representation -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Representation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#professional_context"/>
        <rdfs:comment xml:lang="en">Representation is an intermediary (reified) spatio-temporal context that models the formal relationship in which an organisation—typically an art gallery—represents an artist or an artists’ collective. It captures the fact that representation is historically contingent and may change over time, enabling the association of the represented actant and the representing organisation with a specific time range (and, when relevant, with particular territories or market contexts). In OntoExhibit, Representation supports the analysis of professional networks and institutional mediation, covering activities such as promotion, market brokerage (e.g., sales), and the coordination of exhibition opportunities, without reducing these complex dynamics to a simple, timeless link between artist and gallery.</rdfs:comment>
        <rdfs:label xml:lang="es">representación</rdfs:label>
        <rdfs:label xml:lang="en">representation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Research_Assistant -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Research_Assistant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Assistant"/>
        <rdfs:label xml:lang="es">ayudante de investigación</rdfs:label>
        <rdfs:label xml:lang="en">research assistant</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Role -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Role">
        <rdfs:label xml:lang="es">rol</rdfs:label>
        <rdfs:label xml:lang="en">role</rdfs:label>
        <owl:equivalentClass rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl</owl:equivalentClass>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Scholarly_Critique_Work_Manifestation -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Scholarly_Critique_Work_Manifestation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Work_Manifestation"/>
        <rdfs:label xml:lang="es">obra crítico-académica</rdfs:label>
        <rdfs:label xml:lang="en">scholarly-critique work</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Scholarly_Educational_Activity -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Scholarly_Educational_Activity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#propositional_activity"/>
        <rdfs:comment xml:lang="en">The &quot;Academic-Educational Activity&quot; class represents activities designed to provide educational or scholarly value to participants. These activities are aimed at enhancing knowledge, fostering learning, and promoting academic inquiry within the context of art exhibitions and cultural events. Academic-Educational Activities include workshops, lectures, seminars, guided tours, educational programs, and other instructional sessions intended for students, educators, researchers, and the general public.</rdfs:comment>
        <rdfs:label xml:lang="es">actividad académico-educativa</rdfs:label>
        <rdfs:label xml:lang="en">scholarly-educational activity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Seminar -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Seminar">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Scholarly_Educational_Activity"/>
        <rdfs:label xml:lang="en">seminar</rdfs:label>
        <rdfs:label xml:lang="es">seminario</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Sinopsis -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Sinopsis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Linguistic_Information_Object"/>
        <rdfs:label xml:lang="en">sinopsis</rdfs:label>
        <rdfs:label xml:lang="es">sinopsis</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Site -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Site">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/Place"/>
        <rdfs:comment xml:lang="en">Represents any defined area that facilitates specific art-related activities, encompassing both physical and non-physical (digital or virtual) environments, focusing on the use and significance of each place as a venue for events, interactions, or displays. This class includes buildings, natural landscapes, outdoor areas, as well as specific digital sites that are part of larger digital platforms or virtual environments.</rdfs:comment>
        <rdfs:label xml:lang="en">site</rdfs:label>
        <rdfs:label xml:lang="es">site</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Social_Digital_Place -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Social_Digital_Place">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Digital_Place"/>
        <rdfs:comment xml:lang="en">The &quot;Social Digital Place&quot; class represents digital environments designed to enable social interactions, communication and social engagement among users. Social Digital Places include social media platforms, online forums, and other digital venues that enable users to connect, share, and interact in a social context. This class is of significant cultural relevance, not only due to its frequent use by cultural actors, but also due to the growing tendency to use these spaces as venues for digital exhibitions. Example includes Museo del Prado’s TikTok or exhibitions curated and displayed in Instagram.</rdfs:comment>
        <rdfs:label xml:lang="es">espacio digital social</rdfs:label>
        <rdfs:label xml:lang="en">social digital place</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Social_Interaction -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Social_Interaction">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E5_Event"/>
        <rdfs:comment xml:lang="en">The &quot;Social Reaction&quot; class represents the interactions and responses that occur on social media platforms in relation to artworks, exhibitions, events, or cultural entities. This includes likes, comments, shares, mentions, and other forms of engagement that reflect the public&apos;s reaction and interaction with the content. Social Reactions provide valuable insights into audience perceptions, trends, and the overall impact of the cultural content within the social media landscape.</rdfs:comment>
        <rdfs:label xml:lang="es">interacción social</rdfs:label>
        <rdfs:label xml:lang="en">social interaction</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Social_Publication -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Social_Publication">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Propositional_Object"/>
        <rdfs:comment xml:lang="en">The &quot;Social Publication&quot; class represents forms of digital communication whose content it designed to be shared on social media plataforms, and to be public or semi-public consumed. This includes posts, TikTok vídeos, Instagram stories, etc. Social Publications are characterized by their interactive nature, often encouraging engagement, feedback, and sharing among users. They play a significant role in contemporary communication, social interaction, and digital culture.</rdfs:comment>
        <rdfs:label xml:lang="es">publicación social</rdfs:label>
        <rdfs:label xml:lang="en">social publication</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Spatial_Unit -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Spatial_Unit">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#physical_place"/>
        <rdfs:comment xml:lang="en">Represents a specific segment or part of a larger spatial structure that serves a distinct function or holds significance within the overall environment. This class includes rooms, halls, wings, or any other designated areas within buildings, complexes, or other types of larger spaces. For example: the “Sala Noble” (spatial unit) is the spatial unit of Palacio de Villalón (Building – physical site), which is the headquarters of Museo Carmen Thyssen (Museum – cultural institution).</rdfs:comment>
        <rdfs:label xml:lang="en">spatial unit</rdfs:label>
        <rdfs:label xml:lang="es">unidad espacial</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Supporter -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Supporter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="es">patrocinador</rdfs:label>
        <rdfs:label xml:lang="en">sponsor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Techno-Actant -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Techno-Actant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Actant"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Computational_Object"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasRole"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Assistant"/>
                            <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Collaborator"/>
                            <rdf:Description rdf:about="https://w3id.org/OntoExhibit#Creator"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A technological entity or digital and/or computational object that actively participates in the artistic process or in the conceptualization, design, development, presentation, or interpretation of exhibitions. It may include software, hardware, and automated systems. The incorporation of this class allows OntoExhibit to capture and analyze the integration and impact of advanced technologies, especially AI systems in their multiple modalities, providing a framework to understand how these technological entities modify and affect the realm of artistic exhibitions and curatorial projects. Unlike the Non-Human Actant class, in the context of the OntoExhibit ontology, it is considered that technological entities and computational and/or digital objects inherently enclosed a human component in their design, conceptualization, development, and execution, and therefore cannot be considered non-human entities in a strict sense. This class is included without prejudice to the fact that further discussion about the role these entities play in the field of artistic and curatorial production and creation, and their agency value (their possibilities and their limits) must be developed in the coming years.</rdfs:comment>
        <rdfs:label xml:lang="en">techno-actant</rdfs:label>
        <rdfs:label xml:lang="es">tecnoactante</rdfs:label>
        <modelingNote xml:lang="en">Techno-Actant is treated as a computational object and therefore as a propositional object: its modelling, rules, and operational logics embed explicit or implicit propositions that can intervene in exhibition ecologies (e.g., by producing, filtering, ordering, recommending, or moderating). Its affiliation to Actant expresses an attributed-agency facet in context—how it is referenced as participating in action—without implying personhood and without overriding its status as a produced computational object. This enables research questions such as:  “What implicit propositions about authorship, responsibility, and curatorial agency are embedded in the techno-actant used by exhibition X?” or “How do two techno-actants differ in the propositions they enact through their operational logics—e.g., what they generate, filter, rank, recommend, or moderate—and with what effects on visibility and interpretation?”.</modelingNote>
        <roce_facet rdf:resource="https://w3id.org/OntoExhibit#Actant"/>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Techno-Place -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Techno-Place">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/Place"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Computational_Object"/>
        <rdfs:comment xml:lang="en">Represents any virtual or digital environment that is created, enhanced, or enabled through technological means. In OntoExhibit, the techno-place class is a comprehensive class that comprises the variety of digital and/or technological spaces where the digital and/or computational activities of agents within the art exhibition domain are carried out.</rdfs:comment>
        <rdfs:label xml:lang="en">techno-place</rdfs:label>
        <rdfs:label xml:lang="es">tecnolugar</rdfs:label>
        <modelingNote xml:lang="en">Techno-Place is treated as a computational object and therefore as a propositional object: its design, data models, rules, affordances, and governance embed explicit or implicit propositions that shape what can appear, circulate, and be accessed. Its affiliation to Place expresses a facet of use and reference—how it functions as a locus for exhibition-related interactions and processes—without denying its objecthood or its propositional character. This enables research questions such as:  “What implicit propositions about audiences/participation are embedded in the platform used by exhibition X?” or “How do the propositions of two techno-places differ in their navigation design, permissions, and visibility regimes?”</modelingNote>
        <roce_facet rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/Place"/>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Technological_Corporation -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Technological_Corporation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Company"/>
        <rdfs:label xml:lang="es">corporación tecnológica</rdfs:label>
        <rdfs:label xml:lang="en">technological corporation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Territorial_Entity -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Territorial_Entity">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/Place"/>
        <rdfs:comment xml:lang="en">This class represents any defined area distinguished by administrative or geopolitical boundaries. This class encompasses a wide range of entities from cities and municipalities to states and countries. Each instance of a Territorial Entity is characterized by its governance structures and the legal and political recognition it holds. This class is crucial for analyzing and documenting the geopolitical movement of agents and objects, and for analyzing the influence and interactions of various levels of governance in cultural contexts.</rdfs:comment>
        <rdfs:label xml:lang="es">entidad territorial</rdfs:label>
        <rdfs:label xml:lang="en">territorial entity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Theme -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Theme">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E28_Conceptual_Object"/>
        <rdfs:comment xml:lang="en">A conceptual framework or abstract category used to organize, group, or contextualize content, such as artworks, exhibitions, or narratives. Themes provide a unifying idea or focus, serving as a basis for interpretation, but they are not inherently propositional or subject to verification. E.g.: &quot;The Exploration of Identity Through Modern Art Movements&quot;.</rdfs:comment>
        <rdfs:label xml:lang="es">tema</rdfs:label>
        <rdfs:label xml:lang="en">theme</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Thesis -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Thesis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Proposition"/>
        <rdfs:comment xml:lang="en">A proposition formulated as a thesis: a defendable statement that articulates a central claim or argument within critical, curatorial, scholarly, or institutional discourse.</rdfs:comment>
        <rdfs:label xml:lang="es">tesis</rdfs:label>
        <rdfs:label xml:lang="en">thesis</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Time_Range -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Time_Range">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Time_Span"/>
        <rdfs:comment xml:lang="en">This class represents a span of time characterized by a specific start date and end date, capturing the duration between two defined points tin time.</rdfs:comment>
        <rdfs:label xml:lang="es">rango temporal</rdfs:label>
        <rdfs:label xml:lang="en">time range</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Time_Span -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Time_Span">
        <rdfs:comment xml:lang="en">The &quot;Time Span&quot; class represents a continuous duration or interval of time. This class is used to capture the temporal extent of events, activities, processes, or any phenomena that occur over a period of time. A Time Span can range from very short durations, such as seconds or minutes, to extended periods, such as years, decades, or even millennia.</rdfs:comment>
        <rdfs:label xml:lang="es">periodo de tiempo</rdfs:label>
        <rdfs:label xml:lang="en">time-span</rdfs:label>
        <owl:equivalentClass rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cidoc-crm.org/cidoc-crm/7.1.1/E52_Time-Span</owl:equivalentClass>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Title -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Title">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Linguistic_Information_Object"/>
        <rdfs:label xml:lang="en">title</rdfs:label>
        <rdfs:label xml:lang="es">título</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Tour -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Tour">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Scholarly_Educational_Activity"/>
        <rdfs:label xml:lang="en">tour</rdfs:label>
        <rdfs:label xml:lang="es">tour</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Triennial -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Triennial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Exhibition"/>
        <rdfs:comment xml:lang="en">The &quot;Triennial&quot; class represents a large-scale exhibition event that occurs every three years, showcasing a curated selection of artworks, often from a diverse range of artists, disciplines, and cultural backgrounds. Triennials are significant events in the art world, designed to present contemporary art, foster international cultural exchange, and engage with global artistic trends. These events typically span several months and include various programs such as exhibitions, performances, panel discussions, workshops, and educational activities.</rdfs:comment>
        <rdfs:label xml:lang="es">trienal</rdfs:label>
        <rdfs:label xml:lang="en">triennial</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#University -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#University">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Educational_Institution"/>
        <rdfs:label xml:lang="es">universidad</rdfs:label>
        <rdfs:label xml:lang="en">university</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Urban_Space -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Urban_Space">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Outdoor_Area"/>
        <rdfs:label xml:lang="es">espacio urbano</rdfs:label>
        <rdfs:label xml:lang="en">urban space</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Vernissage -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Vernissage">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Beginning_Of_Activity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/OntoExhibit#hasTimeSpan"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/OntoExhibit#Date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The &quot;Vernissage&quot; class represents the private viewing or preview of an art exhibition, typically held before the official opening to the public. Vernissages are often exclusive events attended by invited guests such as artists, critics, collectors, and other VIPs. These events provide an opportunity for attendees to view the artworks in an intimate setting, often accompanied by speeches, performances, or social gatherings that celebrate the launch of the exhibition.</rdfs:comment>
        <rdfs:label xml:lang="en">vernissage</rdfs:label>
        <rdfs:label xml:lang="es">vernissage</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Visitor -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Visitor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Role"/>
        <rdfs:label xml:lang="es">visitante</rdfs:label>
        <rdfs:label xml:lang="en">visitor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Visual_Identity -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Visual_Identity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Visual_Information_Object"/>
        <rdfs:label xml:lang="es">identidad visual</rdfs:label>
        <rdfs:label xml:lang="en">visual identity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Visual_Information_Object -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Visual_Information_Object">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Information_Object"/>
        <rdfs:label xml:lang="es">objeto de información visual</rdfs:label>
        <rdfs:label xml:lang="en">visual information object</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Visual_Organization_Schema -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Visual_Organization_Schema">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Organization_Schema"/>
        <rdfs:comment xml:lang="en">An ordering structure that specifies visual and spatial patterns of arrangement (e.g., layout logics, visual hierarchies, grids, pathways, alignments, groupings) through which content is made legible or navigable. It captures the schema of visual organization independently of any particular material installation or interface.</rdfs:comment>
        <rdfs:label xml:lang="es">organización visual</rdfs:label>
        <rdfs:label xml:lang="en">visual organization schema</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Web_Page -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Web_Page">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Digital_Place"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Information_Object"/>
        <rdfs:label xml:lang="es">página web</rdfs:label>
        <rdfs:label xml:lang="en">web page</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Website -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Website">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Digital_Place"/>
        <rdfs:comment xml:lang="en">The &quot;Website&quot; class represents a collection of web pages and related content identified by a common domain name and published on at least one web server. In the art exhibition domain, examples include museums&apos; websites that host digital exhibitions and other digital resources related to exhibitions, as well as websites specifically designed for an exhibition, such as the website of the digital exhibition Iconoclash (2023).</rdfs:comment>
        <rdfs:label xml:lang="en">website</rdfs:label>
        <rdfs:label xml:lang="es">website</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Work_Manifestation -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Work_Manifestation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Propositional_Object"/>
        <rdfs:comment xml:lang="en">The &quot;Work Manifestation&quot; class represents a specific realization or embodiment of an intellectual, literary, cultural or artistic work. This can include physical objects, formal expressions, or digital entities that materialize the work in a specific form, making it accessible to audiences.</rdfs:comment>
        <rdfs:label xml:lang="es">manifestación de obra</rdfs:label>
        <rdfs:label xml:lang="en">work manifestation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Workshop -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Workshop">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Scholarly_Educational_Activity"/>
        <rdfs:label xml:lang="es">taller</rdfs:label>
        <rdfs:label xml:lang="en">workshop</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#art_review -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#art_review">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Work_Manifestation"/>
        <rdfs:comment xml:lang="es">In OntoExhibit, an Art Review refers specifically to critical or evaluative texts about artworks and, exhibitions  that are published in mass media, such as newspapers, magazines, journals, or online platforms. These reviews are socio-discursive entities that provide analytical, interpretative, or critical perspectives, often shaping public opinion and influencing the reception of the art or exhibitions they address. This focus allows for the modeling and analysis of the role of art criticism as mediated through public communication channels.</rdfs:comment>
        <rdfs:label xml:lang="en">art review</rdfs:label>
        <rdfs:label xml:lang="es">crítica de arte</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#assingment_critique -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#assingment_critique">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Proposition_Assignment"/>
        <rdfs:label xml:lang="es">asignación de crítica</rdfs:label>
        <rdfs:label xml:lang="en">assingment critique</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#biographical_context -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#biographical_context">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#spatio-temporal_context"/>
        <rdfs:comment xml:lang="en">Biographical context is a subclass of Spatio-temporal context used to model time-qualified circumstances that shape an individual’s life history and trajectory. It groups intermediary constructs that connect a person to places, situations, or other biographical conditions while accounting for change over time (e.g., moving between residences or shifting life settings). Rather than treating such relations as fixed attributes of a person, Biographical context represents them as contextual records anchored to a defined time range, enabling the reconstruction and analysis of biographical geographies and temporal sequences.</rdfs:comment>
        <rdfs:label xml:lang="en">biographical context</rdfs:label>
        <rdfs:label xml:lang="es">contexto biográfico</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#headquarter_assignment -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#headquarter_assignment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#institutional_center_assignment"/>
        <rdfs:comment xml:lang="en">Headquarter is an intermediary (reified) spatio-temporal context that links a collective actant (e.g., a group, community, or corporate body) to its principal physical operational site for a given time range. It represents headquarters information as historically contingent, allowing organisations to be associated with different main addresses or sites across successive periods rather than treating headquarters as a permanent attribute.

In OntoExhibit, Headquarter is intended for cases—especially common in cultural organisations such as galleries—where the official physical base of operations changes over time. It should be distinguished from Location, which may record multiple simultaneous forms of organisational presence (including techno-digital places), and from Activity Place, which captures the wider set of places where an actant conducts activities beyond its principal site..</rdfs:comment>
        <rdfs:label xml:lang="en">headquarter</rdfs:label>
        <rdfs:label xml:lang="es">sede central</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#institutional_center_assignment -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#institutional_center_assignment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#institutional_context"/>
        <rdfs:comment xml:lang="en">Is an intermediary (reified) spatio-temporal context that links a collective actant to a physical place functioning as an institutional facility within a defined time range. It captures the organisational role of a physical site (as part of an institution’s infrastructure) rather than treating the site itself as a type of institution. Instances of Institutional center support the modelling of institutions with multiple facilities and changing spatial infrastructures over time, enabling analysis of institutional footprints, expansions, relocations, and multi-site configurations.</rdfs:comment>
        <rdfs:label xml:lang="es">centro institucional</rdfs:label>
        <rdfs:label xml:lang="en">institutional center</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#institutional_context -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#institutional_context">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#spatio-temporal_context"/>
        <rdfs:comment xml:lang="es">is a subclass of Spatio-temporal context that groups intermediary (reified) constructs used to describe time-qualified institutional configurations and organisational circumstances. It is intended to model historically variable institutional arrangements—such as official locations, centres, and infrastructural presences—without reducing them to timeless attributes of the organisation or to the intrinsic nature of places. In OntoExhibit, Institutional context provides a shared pattern for representing how collective actants are situated and structured across time through formal, institutionally recognised relations to physical and/or techno-digital places.</rdfs:comment>
        <rdfs:label xml:lang="es">contexto institucional</rdfs:label>
        <rdfs:label xml:lang="en">institutional context</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#newspaper -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#newspaper">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Information_Object"/>
        <rdfs:label xml:lang="en">newspaper</rdfs:label>
        <rdfs:label xml:lang="es">periódico</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#ordering_principle -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#ordering_principle">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/E28_Conceptual_Object"/>
        <rdfs:comment xml:lang="en">Ordering Principle designates an abstract principle that governs how elements are ordered, sequenced, grouped, or prioritized in an intellectual work or exhibition-related articulation (e.g., chronological, thematic, geographic, typological, algorithmic). It expresses the logic of ordering, independently of the particular structure that realizes it.</rdfs:comment>
        <rdfs:label xml:lang="en">ordering principle</rdfs:label>
        <rdfs:label xml:lang="es">principio de ordenación</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#physical_place -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#physical_place">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/Place"/>
        <rdfs:label xml:lang="es">espacio físico</rdfs:label>
        <rdfs:label xml:lang="en">physical place</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#process_locus -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#process_locus">
        <rdfs:subClassOf rdf:resource="https://cidoc-crm.org/cidoc-crm/7.1.1/Place"/>
        <rdfs:comment xml:lang="en">Process Locus designates a place understood in its role as the spatial (territorial or techno-digital) locus of a process relevant to curation and/or exhibition making and its associated chains of cultural production. Rather than defining a place by its intrinsic nature (e.g., territory, building, platform), this class captures a contextual function: a place becomes a Process Locus when it is referenced as the location where specific processes occur—such as conception, curation, creation, foundation, dissolution, or destruction—within the broader ecology of exhibitions, artworks, institutions, and cultural agents.

In OntoExhibit, Process Locus is introduced to make explicit the often distributed and multi-sited character of exhibition work. It enables the ontology to distinguish between the frontstage geography of display (e.g., venues/sites where exhibitions are presented) and the backstage geography of production and organization (e.g., where curatorial, creative, and institutional processes are carried out, which may be remote, outsourced, or platform-based). A single place (for instance, a city, a workshop, a museum building, or an online environment) may function as a Process Locus in some contexts and not in others; therefore, Process Locus should not be interpreted as a permanent subtype of place, but as a role inferred from its participation in process-location relations.

By providing a shared conceptual handle over heterogeneous place types, Process Locus supports comparative analysis across cases (e.g., identifying off-site or techno-digital loci of conception and curation, mapping distributed production networks, and measuring degrees of spatial decoupling between production and exhibition). This makes it particularly useful for exhibition studies and curatorial research focused on infrastructures, labor, and the spatial politics of cultural production.</rdfs:comment>
        <rdfs:label xml:lang="es">lugar de procesos</rdfs:label>
        <rdfs:label xml:lang="en">process locus</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#professional_context -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#professional_context">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#spatio-temporal_context"/>
        <rdfs:comment xml:lang="en">Professional context is a subclass of Spatio-temporal context used to model time-qualified relations through which actants participate in professional, institutional, and organisational environments. It groups intermediary constructs that connect people or collectives to places of activity, memberships, affiliations, representative roles, or executive positions, capturing how these relations evolve across time and (when relevant) across space. By reifying these links as contextual records, Professional context supports analyses of careers, networks, institutional trajectories, and the shifting infrastructures through which cultural work is organised within exhibition ecosystems.</rdfs:comment>
        <rdfs:label xml:lang="es">contexto profesional</rdfs:label>
        <rdfs:label xml:lang="en">professional context</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#propositional_activity -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#propositional_activity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Planned_Activity"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Propositional_Entity"/>
        <rdfs:comment xml:lang="en">Propositional Activity designates a planned activity whose defining component includes one or more propositions articulated as its propositional content. It covers activities in which statements, arguments, interpretations, or discursive framings are central to what the activity is and does, enabling them to be related to &quot;Proposition&quot; via &quot;conveys&quot; within OntoExhibit.</rdfs:comment>
        <rdfs:label xml:lang="es">actividad proposicional</rdfs:label>
        <rdfs:label xml:lang="en">propositional activity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#secondary_center_assignment -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#secondary_center_assignment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#institutional_center_assignment"/>
        <rdfs:comment xml:lang="en">This class refers to a subsidiary or additional facility of an institution, distinct from its main headquarters. This center may be the place of activities related to the institution&apos;s mission, providing supplementary services, exhibitions, or resources. It usually serves as an extension of the institution, enhancing its reach and capabilities. Example: &quot;The Villanueva building serve as the headquarters of the Museo del Prado, whereas the Casón del Buen Retiro serves as Secondary Center.&quot;</rdfs:comment>
        <rdfs:label xml:lang="en">secondary center</rdfs:label>
        <rdfs:label xml:lang="es">sede secundaria</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#spatio-temporal_context -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#spatio-temporal_context">
        <rdfs:comment xml:lang="en">Spatio-temporal context is a superclass for intermediary (reified) constructs that qualify relationships by explicitly attaching them to a time range and, when relevant, to a spatial setting or other contextual parameters. It is used to model situations in which a link between an actant (person, collective, institution) and an entity such as a place, an organization, a role, or a position must be expressed as historically variable rather than fixed. Instances of this class therefore function as contextual “records” that capture how a relationship holds during a specific period (and potentially in specific locations), supporting the representation of change over time (e.g., moving residence, shifting memberships, evolving professional affiliations, or relocating areas of activity).

In OntoExhibit, Spatio-temporal context provides a shared modeling pattern for biographical and professional/institutional histories—such as Residency, Place of Activity, Membership, Representation, Executive Position, and Affiliation—by separating the stable entities involved (actants, places, organizations) from the time-qualified contexts that connect them. This design enables robust querying and comparative analysis of trajectories, networks, and spatial distributions across the exhibition ecosystem without conflating entities with the temporalized circumstances in which their relations are enacted.</rdfs:comment>
        <rdfs:label xml:lang="es">contexto espacio-temporal</rdfs:label>
        <rdfs:label xml:lang="en">spatio-temporal context</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/OntoExhibit#Foundation_(Institution) -->


    <owl:Class rdf:about="https://w3id.org/OntoExhibit#Foundation_(Institution)">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Cultural_Institution"/>
        <rdfs:label xml:lang="en">foundation (institution)</rdfs:label>
        <rdfs:label xml:lang="es">fundación (institución)</rdfs:label>
    </owl:Class>
    


    <!-- https://www.iflastandards.info/fr/frbr/frbroo#F11_Corporate_Body -->


    <owl:Class rdf:about="https://www.iflastandards.info/fr/frbr/frbroo#F11_Corporate_Body">
        <rdfs:subClassOf rdf:resource="https://w3id.org/OntoExhibit#Collective_Human_Actant"/>
        <rdfs:comment xml:lang="en">A &quot;Corporate Body&quot; refers to an organization or group of individuals that is recognized by law as a single entity, having its own legal identity separate from that of its members. This class encompasses entities such as corporations, associations, institutions, and government agencies, which can own property, enter into contracts, sue, and be sued in their own name. The corporate body operates through a structured governance system, typically including a board of directors or similar governing body, and is established for specific purposes such as business, education, or public service. The definition of a corporate body highlights its capacity to act as a unified entity in legal, financial, and operational contexts.</rdfs:comment>
        <rdfs:label xml:lang="en">corporate body</rdfs:label>
        <rdfs:label xml:lang="es">organismo corporativo</rdfs:label>
        <owl:equivalentClass rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://xmlns.com/foaf/spec/#term_Group</owl:equivalentClass>
    </owl:Class>
</rdf:RDF>



